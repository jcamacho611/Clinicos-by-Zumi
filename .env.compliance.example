# Compliance & Access Gating Configuration
# Add these to .env.example and update .env for each deployment

# ============================================================================
# FEATURE FLAGS - Control gating behavior during rollout
# ============================================================================
ENABLE_ACCESS_GATE=false
ENABLE_EMAIL_VERIFICATION=false
ENABLE_APPLICATION_REVIEW=false
ENABLE_RATE_LIMITING=false
ENABLE_CAPTCHA=false

# ============================================================================
# EMAIL VERIFICATION & COMMUNICATIONS
# ============================================================================
RESEND_API_KEY=""
RESEND_FROM_EMAIL="noreply@clinicos.local"

# ============================================================================
# CAPTCHA (hCaptcha or reCAPTCHA)
# ============================================================================
CAPTCHA_PROVIDER="hcaptcha"  # or "recaptcha"
hCAPTCHA_SECRET=""
hCAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET=""
RECAPTCHA_SITE_KEY=""

# ============================================================================
# TERMS & LEGAL DOCUMENT VERSIONING
# ============================================================================
ACCESS_TERMS_VERSION="1.0"
PRIVACY_POLICY_VERSION="1.0"
COOKIE_POLICY_VERSION="1.0"

# ============================================================================
# COMPLIANCE & AUDIT
# ============================================================================
AUDIT_LOG_RETENTION_DAYS="2555"  # ~7 years for HIPAA compliance
ENCRYPT_AUDIT_LOGS="true"

# ============================================================================
# STRIPE CONNECT SETUP (Marketplace)
# ============================================================================
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_CONNECT_CLIENT_ID=""
STRIPE_CONNECT_RESTRICTED_API_KEY=""

# ============================================================================
# VENDOR CREDENTIALS - HIPAA & BAA TRACKING
# ============================================================================

# Twilio (SMS/Voice - requires HIPAA plan & BAA)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_VERIFY_SERVICE_SID=""
TWILIO_HIPAA_ENABLED="false"
TWILIO_BAA_SIGNED="false"

# Daily.co (Video - requires HIPAA plan & BAA)
DAILY_API_KEY=""
DAILY_HIPAA_ENABLED="false"
DAILY_BAA_SIGNED="false"

# Stedi (EDI X12 - requires HIPAA BAA)
STEDI_API_KEY=""
STEDI_MODE="sandbox"
STEDI_BAA_SIGNED="false"

# CMS Blue Button (Read-only beneficiary data - no BAA needed)
CMS_BLUE_BUTTON_CLIENT_ID=""
CMS_BLUE_BUTTON_CLIENT_SECRET=""
CMS_BLUE_BUTTON_MODE="sandbox"

# SAM.gov Exclusions (Sanction checking - no BAA needed)
SAM_GOV_API_KEY=""

# Google Maps (Location services - no BAA, avoid PHI)
GOOGLE_MAPS_API_KEY=""
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# ============================================================================
# RATE LIMITING
# ============================================================================
RATE_LIMIT_WINDOW_MS="3600000"  # 1 hour in milliseconds
RATE_LIMIT_MAX_REQUESTS="5"    # 5 requests per window
RATE_LIMIT_SKIP_SUCCESSFUL_REQUESTS="false"  # Count all attempts

# ============================================================================
# SESSION & SECURITY
# ============================================================================
AUTH_SECRET="replace-with-at-least-32-random-characters"
SESSION_MAX_AGE="86400"  # 24 hours in seconds
SESSION_SECURE="true"
SESSION_HTTP_ONLY="true"
SESSION_SAME_SITE="Strict"

# ============================================================================
# TLS & ENCRYPTION
# ============================================================================
FORCE_HTTPS="true"
TLS_MIN_VERSION="1.2"
DOCUMENT_ENCRYPTION_KEY="replace-with-base64-or-hex-encoded-32-byte-key"
