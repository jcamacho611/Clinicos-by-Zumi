DATABASE_URL="postgresql://postgres:postgres@localhost:5432/clinicos"
DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/clinicos"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
AUTH_SECRET="replace-with-at-least-32-random-characters"
DOCUMENT_ENCRYPTION_KEY="replace-with-base64-or-hex-encoded-32-byte-key"
CLINICOS_SEED_ADMIN_PASSWORD="replace-with-at-least-12-characters"
CLINICOS_SEED_PATIENT_PASSWORD="replace-with-a-different-12-character-password"
DEMO_AUTH="true"

# AI provider credentials. Configure only approved providers; never commit real secrets.
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_AI_API_KEY=""
AI_KEY=""

# Zumi = Klinikos Intelligence. Klinikos is the master brand; Zumi is the governed intelligence subsystem.
ZUMI_PROVIDER=""
ZUMI_DISABLED=""
ZUMI_CONVERSATION_SIGNING_SECRET=""

# OpenAI adapter. Keep model and cost rates configuration-owned so provider pricing/model changes do not require code edits.
ZUMI_OPENAI_MODEL="gpt-5-mini"
ZUMI_OPENAI_VECTOR_STORE_ID=""
ZUMI_OPENAI_INPUT_MICRO_USD_PER_M_TOKENS=""
ZUMI_OPENAI_OUTPUT_MICRO_USD_PER_M_TOKENS=""
ZUMI_OPENAI_WEB_SEARCH_MICRO_USD_PER_CALL=""
ZUMI_MAX_TOOL_CALLS="4"
ZUMI_WEB_SEARCH_CONTEXT_SIZE="medium"

# Protected health information egress requires BOTH a signed BAA and deployment approval.
# Public web search is a separate non-PHI research mode and must never receive PHI.
OPENAI_BAA_ON_FILE=""
ZUMI_PHI_EGRESS_APPROVED=""

# Optional curriculum-driven Zumi learning loop. GitHub Actions remains inactive until
# the API key, vector store, and explicit budgets are configured. Money values are integer micro-USD.
ZUMI_LEARNING_MODEL="gpt-5-mini"
ZUMI_LEARNING_BUDGET_MICRO_USD=""
ZUMI_LEARNING_RESERVED_MICRO_USD_PER_TOPIC=""
ZUMI_LEARNING_MAX_TOPICS_PER_RUN="2"
ZUMI_LEARNING_MAX_TOOL_CALLS="4"
ZUMI_LEARNING_MAX_OUTPUT_TOKENS="2200"
ZUMI_LEARNING_SEARCH_CONTEXT_SIZE="medium"

# GRID location intelligence. Restrict browser keys to approved Klinikos origins and server keys by API/IP.
GOOGLE_MAPS_API_KEY=""
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# GRID payments and marketplace payouts.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_CONNECT_CLIENT_ID=""

# GRID communications / account verification.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_VERIFY_SERVICE_SID=""
RESEND_API_KEY=""

# Healthcare transaction gateway. Keep sandbox explicit until production enrollment/BAA approval.
STEDI_API_KEY=""
STEDI_MODE="sandbox"
CMS_BLUE_BUTTON_CLIENT_ID=""
CMS_BLUE_BUTTON_CLIENT_SECRET=""
CMS_BLUE_BUTTON_MODE="sandbox"
SAM_GOV_API_KEY=""

# Secure private evidence storage for credentials/contracts. Use a BAA-capable deployment if PHI may be stored.
OBJECT_STORAGE_ENDPOINT=""
OBJECT_STORAGE_BUCKET=""
OBJECT_STORAGE_ACCESS_KEY_ID=""
OBJECT_STORAGE_SECRET_ACCESS_KEY=""

# Optional GRID agreement/signature and screening adapters. Vendor selection may change; keep behind gateway abstractions.
ESIGN_PROVIDER=""
ESIGN_API_KEY=""
BACKGROUND_CHECK_API_KEY=""

# Telemedicine.
DAILY_API_KEY=""

# Klinikos commercial/platform tenant. Platform fee policy and settlement writes are restricted to this organization.
KLINIKOS_PLATFORM_ORGANIZATION_SLUG="klinikos"
# Legacy persisted/demo alias only. Remove after tenant migration is complete.
CLINICOS_SALES_ORGANIZATION_SLUG="clinicos-by-zumi"
