DATABASE_URL="postgresql://postgres:postgres@localhost:5432/clinicos"
DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/clinicos"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
AUTH_SECRET="replace-with-at-least-32-random-characters"
DOCUMENT_ENCRYPTION_KEY="replace-with-base64-or-hex-encoded-32-byte-key"
CLINICOS_SEED_ADMIN_PASSWORD="replace-with-at-least-12-characters"
CLINICOS_SEED_PATIENT_PASSWORD="replace-with-a-different-12-character-password"
DEMO_AUTH="true"

# Optional external AI-provider credentials. External vendors are not the canonical
# Zumi runtime and must remain behind the governed provider boundary if adapters are
# introduced later. Never commit real secrets.
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_AI_API_KEY=""
AI_KEY=""

# Zumi AI Gateway. Self-hosted inference is the preferred owned-infrastructure path.
# The endpoint must expose an OpenAI-compatible POST /v1/chat/completions API.
# Leaving the endpoint/model blank keeps Zumi in Pending Connection. ZUMI_DISABLED is
# the deployment kill switch and stops all model egress without a redeploy.
ZUMI_PROVIDER="self_hosted"
ZUMI_SELF_HOSTED_BASE_URL=""
ZUMI_SELF_HOSTED_MODEL=""
# Optional bearer token if the internal inference service is authenticated.
ZUMI_SELF_HOSTED_API_KEY=""
ZUMI_DISABLED=""

# Protected health information remains blocked by default. Running inference on
# Klinikos-operated infrastructure does NOT itself prove the deployment is approved
# for PHI. The current provider assurance contract still requires explicit deployment
# approval and an adapter-level BAA flag, so the self-hosted adapter intentionally
# remains PHI-ineligible until that assurance model is deliberately generalized and
# reviewed. Do not set this merely because the server is ours.
ZUMI_PHI_EGRESS_APPROVED=""

# GRID location intelligence. Restrict browser keys to approved Klinikos origins and server keys by API/IP.
# Enable only the Google Maps APIs actually used by the deployment: Maps JavaScript, Places, Geocoding, Routes,
# Route Matrix, and optional Address Validation.
GOOGLE_MAPS_API_KEY=""
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# GRID payments and marketplace payouts.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_CONNECT_CLIENT_ID=""

# GRID communications / account verification.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_VERIFY_SERVICE_SID=""
RESEND_API_KEY=""

# Healthcare transaction gateway. Keep sandbox explicit until production enrollment/BAA approval.
STEDI_API_KEY=""
STEDI_MODE="sandbox"
CMS_BLUE_BUTTON_CLIENT_ID=""
CMS_BLUE_BUTTON_CLIENT_SECRET=""
CMS_BLUE_BUTTON_MODE="sandbox"
SAM_GOV_API_KEY=""

# Secure private evidence storage for credentials/contracts. Use an approved deployment if PHI may be stored.
OBJECT_STORAGE_ENDPOINT=""
OBJECT_STORAGE_BUCKET=""
OBJECT_STORAGE_ACCESS_KEY_ID=""
OBJECT_STORAGE_SECRET_ACCESS_KEY=""

# Optional GRID agreement/signature and screening adapters. Vendor selection may change; keep behind gateway abstractions.
ESIGN_PROVIDER=""
ESIGN_API_KEY=""
BACKGROUND_CHECK_API_KEY=""

# Telemedicine.
DAILY_API_KEY=""

# Klinikos commercial/platform tenant. Platform fee policy and settlement writes are restricted to this organization.
# Keep the legacy sales slug aligned until the tenant is renamed in persisted data.
KLINIKOS_PLATFORM_ORGANIZATION_SLUG="clinicos-by-zumi"
CLINICOS_SALES_ORGANIZATION_SLUG="clinicos-by-zumi"
