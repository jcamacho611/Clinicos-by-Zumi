DATABASE_URL="postgresql://postgres:postgres@localhost:5432/clinicos"
DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/clinicos"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
AUTH_SECRET="replace-with-at-least-32-random-characters"
DOCUMENT_ENCRYPTION_KEY="replace-with-base64-or-hex-encoded-32-byte-key"
CLINICOS_SEED_ADMIN_PASSWORD="replace-with-at-least-12-characters"
CLINICOS_SEED_PATIENT_PASSWORD="replace-with-a-different-12-character-password"
DEMO_AUTH="true"

# Zumi conversation identity. Founder mode is activated ONLY by authenticated user IDs
# listed here; names, emails, prompts, and claimed titles never activate it.
KLINIKOS_FOUNDER_USER_IDS=""
ZUMI_CONVERSATION_SIGNING_SECRET=""

# Immediate abuse resistance for the Zumi HTTP endpoint. This limiter is per-process;
# production multi-instance deployments still need a shared edge/data-layer limiter.
ZUMI_RATE_LIMIT_WINDOW_MS="60000"
ZUMI_RATE_LIMIT_MAX_REQUESTS="30"

# Deep cognition controls. Direct/research turns remain one-pass. Deep turns may run a
# bounded plan -> investigate -> critic -> repair sequence. The cost limit is integer
# micro-USD for the whole turn; 250000 = $0.25. Set enabled=false or max passes=1 to
# collapse deep turns back to a single provider call without disabling Zumi.
ZUMI_DEEP_COGNITION_ENABLED="true"
ZUMI_DEEP_MAX_PASSES="4"
ZUMI_MAX_TURN_COST_MICRO_USD="250000"

# High-risk action step-up proofs. The actual reauthentication/MFA/passkey ceremony is
# separate; this secret signs the short-lived proof produced after that ceremony.
KLINIKOS_STEP_UP_SIGNING_SECRET=""

# Optional external AI-provider credentials. Every provider remains behind the same
# governed Zumi provider boundary. Never commit real secrets.
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_AI_API_KEY=""
AI_KEY=""

# Zumi AI Gateway. Self-hosted inference remains a first-class owned-infrastructure
# option. The endpoint must expose an OpenAI-compatible POST /v1/chat/completions API.
# Leaving endpoint/model blank keeps the adapter Pending Connection.
ZUMI_PROVIDER="self_hosted"
ZUMI_SELF_HOSTED_BASE_URL=""
ZUMI_SELF_HOSTED_MODEL=""
ZUMI_SELF_HOSTED_API_KEY=""
ZUMI_DISABLED=""

# Optional OpenAI Responses adapter for provider-native conversation state and hosted
# research tools. Model and cost rates are explicit rather than silently assumed.
# Configure ZUMI_PROVIDER="openai" to select it explicitly.
ZUMI_OPENAI_MODEL=""
ZUMI_OPENAI_INPUT_MICRO_USD_PER_M_TOKENS=""
ZUMI_OPENAI_OUTPUT_MICRO_USD_PER_M_TOKENS=""
ZUMI_OPENAI_WEB_SEARCH_MICRO_USD_PER_CALL=""
ZUMI_OPENAI_VECTOR_STORE_ID=""
ZUMI_OPENAI_CODE_INTERPRETER=""
ZUMI_WEB_SEARCH_CONTEXT_SIZE="medium"
OPENAI_BAA_ON_FILE=""

# Protected health information remains blocked by default. Running inference on
# Klinikos-operated infrastructure does NOT itself prove the deployment is approved
# for PHI. Do not set this merely because the server is ours.
ZUMI_PHI_EGRESS_APPROVED=""

# GRID location intelligence. Restrict browser keys to approved Klinikos origins and server keys by API/IP.
# Enable only the Google Maps APIs actually used by the deployment: Maps JavaScript, Places, Geocoding, Routes,
# Route Matrix, and optional Address Validation.
GOOGLE_MAPS_API_KEY=""
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# GRID payments and marketplace payouts.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_CONNECT_CLIENT_ID=""

# GRID communications / account verification.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_VERIFY_SERVICE_SID=""
RESEND_API_KEY=""

# Healthcare transaction gateway. Keep sandbox explicit until production enrollment/BAA approval.
STEDI_API_KEY=""
STEDI_MODE="sandbox"
CMS_BLUE_BUTTON_CLIENT_ID=""
CMS_BLUE_BUTTON_CLIENT_SECRET=""
CMS_BLUE_BUTTON_MODE="sandbox"
SAM_GOV_API_KEY=""

# Secure private evidence storage for credentials/contracts. Use an approved deployment if PHI may be stored.
OBJECT_STORAGE_ENDPOINT=""
OBJECT_STORAGE_BUCKET=""
OBJECT_STORAGE_ACCESS_KEY_ID=""
OBJECT_STORAGE_SECRET_ACCESS_KEY=""

# Optional GRID agreement/signature and screening adapters. Vendor selection may change; keep behind gateway abstractions.
ESIGN_PROVIDER=""
ESIGN_API_KEY=""
BACKGROUND_CHECK_API_KEY=""

# Telemedicine.
DAILY_API_KEY=""

# Klinikos commercial/platform tenant. Platform fee policy and settlement writes are restricted to this organization.
# Legacy persisted slugs may remain until a data migration changes them; they are not public brand names.
KLINIKOS_PLATFORM_ORGANIZATION_SLUG="clinicos-by-zumi"
CLINICOS_SALES_ORGANIZATION_SLUG="clinicos-by-zumi"