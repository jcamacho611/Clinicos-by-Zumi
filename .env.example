DATABASE_URL="postgresql://postgres:postgres@localhost:5432/clinicos"
DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/clinicos"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
AUTH_SECRET="replace-with-at-least-32-random-characters"
DOCUMENT_ENCRYPTION_KEY="replace-with-base64-or-hex-encoded-32-byte-key"
CLINICOS_SEED_ADMIN_PASSWORD="replace-with-at-least-12-characters"
CLINICOS_SEED_PATIENT_PASSWORD="replace-with-a-different-12-character-password"
DEMO_AUTH="true"

# Legal execution and protected-access gate. Leave enforcement false/blank until the
# legal-evidence migration is deployed, the factual contracting entity/law/forum are
# approved, and controlled unsigned -> sign -> access testing succeeds. Do not invent
# these values merely to make the gate look complete.
LEGAL_GATE_ENFORCEMENT_ENABLED=""
KLINIKOS_LEGAL_ENTITY_NAME=""
KLINIKOS_LEGAL_CONTACT_EMAIL="hello@klinikos.io"
KLINIKOS_GOVERNING_LAW=""
KLINIKOS_LEGAL_FORUM=""

# Person-level free membership. Keep this OFF until the universal-account and durable
# public-mutation migrations are verified, member -> Clinic OS denial is proven,
# legacy staff login compatibility passes, and the Website Terms + Privacy Policy are
# explicitly production-approved in the legal registry. Enabling this creates only a
# Person/Account. It never grants organization, professional, clinical, patient, Grid,
# EDU, payment, or other consequential authority.
KLINIKOS_FREE_MEMBER_SIGNUP_ENABLED=""

# Legacy public organization creation is a non-production synthetic test seam only.
# Leave false/blank in production. Paid clinic workspaces use the commercial activation desk.
KLINIKOS_SYNTHETIC_WORKSPACE_CREATION=""

# Operator evidence for the Production Readiness screen. Set only after an actual
# backup/restore exercise and use an ISO-8601 timestamp, for example 2026-08-12T15:00:00Z.
KLINIKOS_BACKUP_VERIFIED_AT=""

# Exact-value GoDaddy subscription paylinks. Never reuse the $500 Operational Audit
# link for subscription activation. Each plan must point to the payment rail that
# actually charges that plan's server-owned amount.
KLINIKOS_GODADDY_CORE_PAYLINK=""
KLINIKOS_GODADDY_GROWTH_PAYLINK=""
KLINIKOS_GODADDY_SCALE_PAYLINK=""

# Zumi conversation identity. Founder mode is activated ONLY by authenticated user IDs
# listed here; names, emails, prompts, and claimed titles never activate it.
KLINIKOS_FOUNDER_USER_IDS=""
ZUMI_CONVERSATION_SIGNING_SECRET=""

# Immediate abuse resistance for the Zumi HTTP endpoint. This limiter is per-process;
# production multi-instance deployments still need a shared edge/data-layer limiter.
ZUMI_RATE_LIMIT_WINDOW_MS="60000"
ZUMI_RATE_LIMIT_MAX_REQUESTS="30"

# Deep cognition controls. Direct/research turns remain one-pass. Deep turns may run a
# bounded plan -> investigate -> critic -> repair sequence. The cost limit is integer
# micro-USD for the whole turn; 250000 = $0.25. Set enabled=false or max passes=1 to
# collapse deep turns back to a single provider call without disabling Zumi.
ZUMI_DEEP_COGNITION_ENABLED="true"
ZUMI_DEEP_MAX_PASSES="4"
ZUMI_MAX_TURN_COST_MICRO_USD="250000"

# High-risk action step-up proofs. The actual reauthentication/MFA/passkey ceremony is
# separate; this secret signs the short-lived proof produced after that ceremony.
KLINIKOS_STEP_UP_SIGNING_SECRET=""

# Optional external AI-provider credentials. Every provider remains behind the same
# governed Zumi provider boundary. Never commit real secrets.
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_AI_API_KEY=""
AI_KEY=""

# Zumi AI Gateway. Select exactly one provider explicitly in production.
# Leaving a selected provider's required values blank keeps Zumi Pending Connection.
ZUMI_PROVIDER="self_hosted"
ZUMI_DISABLED=""

# Klinikos-operated OpenAI-compatible inference. The endpoint must expose
# POST /v1/chat/completions. This can sit on llama.cpp, vLLM, SGLang, or another
# controlled runtime without changing the rest of the Zumi gateway.
ZUMI_SELF_HOSTED_BASE_URL=""
ZUMI_SELF_HOSTED_MODEL=""
ZUMI_SELF_HOSTED_API_KEY=""

# Cloudflare Workers AI. Set ZUMI_PROVIDER="cloudflare" to use this rail.
# Create a scoped Workers AI API token and copy the Cloudflare Account ID. Model and
# cost rates must be copied from current official pricing for the exact selected model.
# Cost values are integer micro-USD per one million tokens; 45000 means $0.045/M.
# Do not subtract account-wide free allocations from these per-request marginal rates.
# Optional gateway ID routes through Cloudflare AI Gateway for observability, caching,
# rate limiting, and guardrails. Never commit the API token.
ZUMI_CLOUDFLARE_ACCOUNT_ID=""
ZUMI_CLOUDFLARE_API_TOKEN=""
ZUMI_CLOUDFLARE_MODEL=""
ZUMI_CLOUDFLARE_INPUT_MICRO_USD_PER_M_TOKENS=""
ZUMI_CLOUDFLARE_OUTPUT_MICRO_USD_PER_M_TOKENS=""
ZUMI_CLOUDFLARE_GATEWAY_ID=""

# Optional OpenAI Responses adapter for provider-native conversation state and hosted
# research tools. Model and cost rates are explicit rather than silently assumed.
# Configure ZUMI_PROVIDER="openai" to select it explicitly. Hosted-tool rates are
# integer micro-USD per provider billable call/session and are required whenever that
# paid tool is enabled. Copy current official pricing for the exact deployed contract;
# do not infer that a missing rate means free usage.
ZUMI_OPENAI_MODEL=""
ZUMI_OPENAI_INPUT_MICRO_USD_PER_M_TOKENS=""
ZUMI_OPENAI_OUTPUT_MICRO_USD_PER_M_TOKENS=""
ZUMI_OPENAI_WEB_SEARCH_MICRO_USD_PER_CALL=""
ZUMI_OPENAI_FILE_SEARCH_MICRO_USD_PER_CALL=""
