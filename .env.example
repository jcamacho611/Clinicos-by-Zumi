DATABASE_URL="postgresql://postgres:postgres@localhost:5432/clinicos"
DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/clinicos"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
AUTH_SECRET="replace-with-at-least-32-random-characters"
DOCUMENT_ENCRYPTION_KEY="replace-with-base64-or-hex-encoded-32-byte-key"
CLINICOS_SEED_ADMIN_PASSWORD="replace-with-at-least-12-characters"
CLINICOS_SEED_PATIENT_PASSWORD="replace-with-a-different-12-character-password"
DEMO_AUTH="true"

# Legacy public organization creation is a non-production synthetic test seam only.
# Leave false/blank in production. Paid clinic workspaces use the commercial activation desk.
KLINIKOS_SYNTHETIC_WORKSPACE_CREATION=""

# Operator evidence for the Production Readiness screen. Set only after an actual
# backup/restore exercise and use an ISO-8601 timestamp, for example 2026-08-12T15:00:00Z.
KLINIKOS_BACKUP_VERIFIED_AT=""

# Exact-value GoDaddy subscription paylinks. Never reuse the $500 Operational Audit
# link for subscription activation. Each plan must point to the payment rail that
# actually charges that plan's server-owned amount.
KLINIKOS_GODADDY_CORE_PAYLINK=""
KLINIKOS_GODADDY_GROWTH_PAYLINK=""
KLINIKOS_GODADDY_SCALE_PAYLINK=""

# Zumi conversation identity. Founder mode is activated ONLY by authenticated user IDs
# listed here; names, emails, prompts, and claimed titles never activate it.
KLINIKOS_FOUNDER_USER_IDS=""
ZUMI_CONVERSATION_SIGNING_SECRET=""

# Immediate abuse resistance for the Zumi HTTP endpoint. This limiter is per-process;
# production multi-instance deployments still need a shared edge/data-layer limiter.
ZUMI_RATE_LIMIT_WINDOW_MS="60000"
ZUMI_RATE_LIMIT_MAX_REQUESTS="30"

# Deep cognition controls. Direct/research turns remain one-pass. Deep turns may run a
# bounded plan -> investigate -> critic -> repair sequence. The cost limit is integer
# micro-USD for the whole turn; 250000 = $0.25. Set enabled=false or max passes=1 to
# collapse deep turns back to a single provider call without disabling Zumi.
ZUMI_DEEP_COGNITION_ENABLED="true"
ZUMI_DEEP_MAX_PASSES="4"
ZUMI_MAX_TURN_COST_MICRO_USD="250000"

# High-risk action step-up proofs. The actual reauthentication/MFA/passkey ceremony is
# separate; this secret signs the short-lived proof produced after that ceremony.
KLINIKOS_STEP_UP_SIGNING_SECRET=""

# Optional external AI-provider credentials. Every provider remains behind the same
# governed Zumi provider boundary. Never commit real secrets.
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_AI_API_KEY=""
AI_KEY=""

# Zumi AI Gateway. Select exactly one provider explicitly in production.
# Leaving a selected provider's required values blank keeps Zumi Pending Connection.
ZUMI_PROVIDER="self_hosted"
ZUMI_DISABLED=""

# Klinikos-operated OpenAI-compatible inference. The endpoint must expose
# POST /v1/chat/completions. This can sit on llama.cpp, vLLM, SGLang, or another
# controlled runtime without changing the rest of the Zumi gateway.
ZUMI_SELF_HOSTED_BASE_URL=""
ZUMI_SELF_HOSTED_MODEL=""
ZUMI_SELF_HOSTED_API_KEY=""

# Cloudflare Workers AI. Set ZUMI_PROVIDER="cloudflare" to use this rail.
# Create a scoped Workers AI API token and copy the Cloudflare Account ID. The model
# should be an exact active Workers AI model identifier, e.g. @cf/meta/llama-3.1-8b-instruct-fast.
# Optional gateway ID routes through Cloudflare AI Gateway for its observability,
# caching, rate limiting, and guardrails. Never commit the API token.
ZUMI_CLOUDFLARE_ACCOUNT_ID=""
ZUMI_CLOUDFLARE_API_TOKEN=""
ZUMI_CLOUDFLARE_MODEL="@cf/meta/llama-3.1-8b-instruct-fast"
ZUMI_CLOUDFLARE_GATEWAY_ID=""

# Optional OpenAI Responses adapter for provider-native conversation state and hosted
# research tools. Model and cost rates are explicit rather than silently assumed.
# Configure ZUMI_PROVIDER="openai" to select it explicitly.
ZUMI_OPENAI_MODEL=""
ZUMI_OPENAI_INPUT_MICRO_USD_PER_M_TOKENS=""
ZUMI_OPENAI_OUTPUT_MICRO_USD_PER_M_TOKENS=""
ZUMI_OPENAI_WEB_SEARCH_MICRO_USD_PER_CALL=""
ZUMI_OPENAI_VECTOR_STORE_ID=""
ZUMI_OPENAI_CODE_INTERPRETER=""
ZUMI_WEB_SEARCH_CONTEXT_SIZE="medium"
OPENAI_BAA_ON_FILE=""

# Protected health information remains blocked by default. Running inference on
# Klinikos-operated infrastructure or connecting Cloudflare does NOT itself prove the
# deployment is approved for PHI. Do not set this merely because inference is live.
ZUMI_PHI_EGRESS_APPROVED=""

# Customer-funded variable-cost allowances. Values are integer cents per billing
# period. Blank means zero included budget; Klinikos then requires prepaid funds or an
# explicitly bounded overage authorization before variable vendor spend.
KLINIKOS_ALLOWANCE_CORE_AI_CENTS=""
KLINIKOS_ALLOWANCE_CORE_VOICE_CENTS=""
KLINIKOS_ALLOWANCE_CORE_SMS_CENTS=""
KLINIKOS_ALLOWANCE_CORE_EMAIL_CENTS=""
KLINIKOS_ALLOWANCE_CORE_MAPS_CENTS=""
KLINIKOS_ALLOWANCE_CORE_DOCUMENTS_CENTS=""
KLINIKOS_ALLOWANCE_CORE_STORAGE_CENTS=""
KLINIKOS_ALLOWANCE_CORE_INTEGRATIONS_CENTS=""
KLINIKOS_ALLOWANCE_GROWTH_AI_CENTS=""
KLINIKOS_ALLOWANCE_GROWTH_VOICE_CENTS=""
KLINIKOS_ALLOWANCE_GROWTH_SMS_CENTS=""
KLINIKOS_ALLOWANCE_GROWTH_EMAIL_CENTS=""
KLINIKOS_ALLOWANCE_GROWTH_MAPS_CENTS=""
KLINIKOS_ALLOWANCE_GROWTH_DOCUMENTS_CENTS=""
KLINIKOS_ALLOWANCE_GROWTH_STORAGE_CENTS=""
KLINIKOS_ALLOWANCE_GROWTH_INTEGRATIONS_CENTS=""
KLINIKOS_ALLOWANCE_SCALE_AI_CENTS=""
KLINIKOS_ALLOWANCE_SCALE_VOICE_CENTS=""
KLINIKOS_ALLOWANCE_SCALE_SMS_CENTS=""
KLINIKOS_ALLOWANCE_SCALE_EMAIL_CENTS=""
KLINIKOS_ALLOWANCE_SCALE_MAPS_CENTS=""
KLINIKOS_ALLOWANCE_SCALE_DOCUMENTS_CENTS=""
KLINIKOS_ALLOWANCE_SCALE_STORAGE_CENTS=""
KLINIKOS_ALLOWANCE_SCALE_INTEGRATIONS_CENTS=""

# Legacy clinic allowance names retained for already-recorded clinic_operator plans.
KLINIKOS_ALLOWANCE_CLINIC_AI_CENTS=""
KLINIKOS_ALLOWANCE_CLINIC_VOICE_CENTS=""
KLINIKOS_ALLOWANCE_CLINIC_SMS_CENTS=""
KLINIKOS_ALLOWANCE_CLINIC_EMAIL_CENTS=""
KLINIKOS_ALLOWANCE_CLINIC_MAPS_CENTS=""
KLINIKOS_ALLOWANCE_CLINIC_DOCUMENTS_CENTS=""
KLINIKOS_ALLOWANCE_CLINIC_STORAGE_CENTS=""
KLINIKOS_ALLOWANCE_CLINIC_INTEGRATIONS_CENTS=""
KLINIKOS_ALLOWANCE_GRID_PROFESSIONAL_MAPS_CENTS=""
KLINIKOS_ALLOWANCE_GRID_FACILITY_MAPS_CENTS=""

# GRID location intelligence.
# Core interactive Grid mapping uses MapLibre + OpenFreeMap and browser geolocation;
# it requires no Google/OpenFreeMap credential. Geoapify is an optional future
# server-side geocoding/routing enhancement. Google remains an optional paid adapter.
GEOAPIFY_API_KEY=""
GOOGLE_MAPS_API_KEY=""
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=""

# GRID payments and marketplace payouts.
# Production Checkout is live-only and activates only when both the live key and
# live webhook secret are configured. Test mode must be selected explicitly by
# test tooling; it never falls back into the production webhook route.
STRIPE_SECRET_KEY=""
STRIPE_TEST_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_TEST_WEBHOOK_SECRET=""
STRIPE_CONNECT_CLIENT_ID=""

# GRID communications / account verification.
# Outbound Twilio REST calls use the restricted API-key SID + one-time API-key secret.
# A Messaging Service SID is required for outbound SMS; a Verify Service SID is used
# for phone-possession verification. The master Auth Token is NOT normal outbound auth
# and should be supplied only if a future inbound Twilio webhook needs signature validation.
TWILIO_ACCOUNT_SID=""
TWILIO_API_KEY_SID=""
TWILIO_API_KEY_SECRET=""
TWILIO_MESSAGING_SERVICE_SID=""
TWILIO_VERIFY_SERVICE_SID=""
TWILIO_AUTH_TOKEN=""
RESEND_API_KEY=""

# Healthcare transaction gateway. Keep sandbox explicit until production enrollment/BAA approval.
STEDI_API_KEY=""
STEDI_MODE="sandbox"
CMS_BLUE_BUTTON_CLIENT_ID=""
CMS_BLUE_BUTTON_CLIENT_SECRET=""
CMS_BLUE_BUTTON_MODE="sandbox"
SAM_GOV_API_KEY=""

# Secure private evidence storage for credentials/contracts. Use an approved deployment if PHI may be stored.
OBJECT_STORAGE_ENDPOINT=""
OBJECT_STORAGE_BUCKET=""
OBJECT_STORAGE_ACCESS_KEY_ID=""
OBJECT_STORAGE_SECRET_ACCESS_KEY=""

# Optional GRID agreement/signature and screening adapters. Vendor selection may change; keep behind gateway abstractions.
ESIGN_PROVIDER=""
ESIGN_API_KEY=""
BACKGROUND_CHECK_API_KEY=""

# Telemedicine.
DAILY_API_KEY=""

# Klinikos commercial/platform tenant. Platform fee policy and settlement writes are restricted to this organization.
# Legacy persisted slugs may remain until a data migration changes them; they are not public brand names.
KLINIKOS_PLATFORM_ORGANIZATION_SLUG="clinicos-by-zumi"
CLINICOS_SALES_ORGANIZATION_SLUG="clinicos-by-zumi"
