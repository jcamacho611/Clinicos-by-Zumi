DATABASE_URL="postgresql://postgres:postgres@localhost:5432/clinicos"
DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/clinicos"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
AUTH_SECRET="replace-with-at-least-32-random-characters"
DOCUMENT_ENCRYPTION_KEY="replace-with-base64-or-hex-encoded-32-byte-key"
CLINICOS_SEED_ADMIN_PASSWORD="replace-with-at-least-12-characters"
CLINICOS_SEED_PATIENT_PASSWORD="replace-with-a-different-12-character-password"
DEMO_AUTH="true"

# AI Gateway providers. Configure only approved providers; never commit real secrets.
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_AI_API_KEY=""
AI_KEY=""

# Zumi AI Gateway. With none of these set and no provider adapter registered, Zumi
# reports Pending Connection and refuses every request — that is the intended default.
# ZUMI_PROVIDER names a registered adapter explicitly; unset falls back to the first
# configured one. ZUMI_DISABLED is a deployment kill switch that stops all AI egress
# without a redeploy.
ZUMI_PROVIDER=""
ZUMI_DISABLED=""
# The model the Anthropic adapter calls. Required — there is deliberately no built-in
# default, because a model identifier hard-coded in source goes stale and then fails at
# runtime against a clinic instead of at configuration time. Set it to a model the
# deployment's Anthropic account is actually entitled to; until it is set, Zumi reports
# Pending Connection.
ZUMI_ANTHROPIC_MODEL=""
# Optional. Integer micro-USD per million tokens, used for the estimated-cost column in
# the usage ledger. Set these to the rate for the model above; unset falls back to a
# mid-tier list price so the ledger records an approximation rather than zero.
ZUMI_ANTHROPIC_INPUT_MICRO_USD_PER_MTOK=""
ZUMI_ANTHROPIC_OUTPUT_MICRO_USD_PER_MTOK=""
# Protected health information must never leave for a model provider unless a Business
# Associate Agreement is executed with that provider AND this deployment is approved
# for it. Both conditions are required; leave this unset until counsel confirms both.
ZUMI_PHI_EGRESS_APPROVED=""

# Klinikos Growth Engine. The Operational Audit checkout destination. Public URL, not a
# secret — it takes payment, it grants nothing. Opening it is never treated as proof of
# payment; a person confirms with the payment provider before any access is granted.
KLINIKOS_AUDIT_PAYLINK=""

# The one organization allowed to see the marketplace payment queue across tenants.
# Unset means nobody has platform scope, and every operator sees only their own
# organization's purchases — which is the safe default, so leave it unset unless a
# Klinikos-operated tenant genuinely needs the global queue.
KLINIKOS_PLATFORM_ORG_ID=""

# GRID location intelligence. Restrict browser keys to approved Klinikos origins and server keys by API/IP.
# Enable only the Google Maps APIs actually used by the deployment: Maps JavaScript, Places, Geocoding, Routes,
# Route Matrix, and optional Address Validation.
GOOGLE_MAPS_API_KEY=""
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# GRID payments and marketplace payouts.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_CONNECT_CLIENT_ID=""

# Whop-first paid access entry. Without WHOP_API_KEY and at least one plan id the
# paid entry surface reports "Pending Connection" and grants nothing. Without
# WHOP_WEBHOOK_SECRET the webhook rejects every delivery.
WHOP_API_KEY=""
WHOP_WEBHOOK_SECRET=""
WHOP_API_BASE="https://api.whop.com"
WHOP_CHECKOUT_BASE="https://whop.com"
# Set only if the configured Whop webhook signs without a timestamp. Leaving this
# unset keeps replay protection on.
WHOP_WEBHOOK_ALLOW_UNTIMESTAMPED=""
# Whop plan ids per Klinikos access tier (recurring access passes).
# An unmapped plan can never grant access.
WHOP_PLAN_EVALUATOR_PASS=""
WHOP_PLAN_CLINIC_OPERATOR=""
WHOP_PLAN_GRID_PROVIDER=""
WHOP_PLAN_GRID_LOCATION_PARTNER=""

# Whop checkout links per one-time marketplace product. Prices are server-controlled
# in src/lib/commerce/access-product-catalog.ts; these only say where to send buyers.
# A product with no link here is shown as Pending Connection and cannot be ordered.
WHOP_PRODUCTS_CLINIC_WORKFLOW_REVIEW=""
WHOP_PRODUCTS_FOUNDING_CLINIC_SEAT=""
WHOP_PRODUCTS_CONTRACTOR_APPLICATION_REVIEW=""
WHOP_PRODUCTS_ROOM_LISTING_REVIEW=""
WHOP_PRODUCTS_SELLER_LISTING_REVIEW=""
WHOP_PRODUCTS_AI_CONSULTING_CALL=""

# GRID communications / account verification.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_VERIFY_SERVICE_SID=""
RESEND_API_KEY=""
ACCESS_EMAIL_FROM="Klinikos Access <access@klinikos.io>"

# Healthcare transaction gateway. Keep sandbox explicit until production enrollment/BAA approval.
STEDI_API_KEY=""
STEDI_MODE="sandbox"
CMS_BLUE_BUTTON_CLIENT_ID=""
CMS_BLUE_BUTTON_CLIENT_SECRET=""
CMS_BLUE_BUTTON_MODE="sandbox"
SAM_GOV_API_KEY=""

# Secure private evidence storage for credentials/contracts. Use a BAA-capable deployment if PHI may be stored.
OBJECT_STORAGE_ENDPOINT=""
OBJECT_STORAGE_BUCKET=""
OBJECT_STORAGE_ACCESS_KEY_ID=""
OBJECT_STORAGE_SECRET_ACCESS_KEY=""

# Optional GRID agreement/signature and screening adapters. Vendor selection may change; keep behind gateway abstractions.
ESIGN_PROVIDER=""
ESIGN_API_KEY=""
BACKGROUND_CHECK_API_KEY=""

# Telemedicine.
DAILY_API_KEY=""

# Optional sales-owner tenant for qualification / implementation workflows.
CLINICOS_SALES_ORGANIZATION_SLUG="clinicos-by-zumi"
