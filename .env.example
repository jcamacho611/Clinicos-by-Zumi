DATABASE_URL="postgresql://postgres:postgres@localhost:5432/clinicos"
DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/clinicos"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
AUTH_SECRET="replace-with-at-least-32-random-characters"
DOCUMENT_ENCRYPTION_KEY="replace-with-base64-or-hex-encoded-32-byte-key"
CLINICOS_SEED_ADMIN_PASSWORD="replace-with-at-least-12-characters"
CLINICOS_SEED_PATIENT_PASSWORD="replace-with-a-different-12-character-password"
DEMO_AUTH="true"

# AI Gateway providers. Configure only approved providers; never commit real secrets.
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_AI_API_KEY=""
AI_KEY=""

# Zumi AI Gateway. With none of these set and no provider adapter registered, Zumi
# reports Pending Connection and refuses every request — that is the intended default.
# ZUMI_PROVIDER names a registered adapter explicitly; unset falls back to the first
# configured one. ZUMI_DISABLED is a deployment kill switch that stops all AI egress
# without a redeploy.
ZUMI_PROVIDER=""
ZUMI_DISABLED=""
# Protected health information must never leave for a model provider unless a Business
# Associate Agreement is executed with that provider AND this deployment is approved
# for it. Both conditions are required; leave this unset until counsel confirms both.
ZUMI_PHI_EGRESS_APPROVED=""

# GRID location intelligence. Restrict browser keys to approved Klinikos origins and server keys by API/IP.
# Enable only the Google Maps APIs actually used by the deployment: Maps JavaScript, Places, Geocoding, Routes,
# Route Matrix, and optional Address Validation.
GOOGLE_MAPS_API_KEY=""
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# GRID payments and marketplace payouts.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_CONNECT_CLIENT_ID=""

# GRID communications / account verification.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_VERIFY_SERVICE_SID=""
RESEND_API_KEY=""

# Healthcare transaction gateway. Keep sandbox explicit until production enrollment/BAA approval.
STEDI_API_KEY=""
STEDI_MODE="sandbox"
CMS_BLUE_BUTTON_CLIENT_ID=""
CMS_BLUE_BUTTON_CLIENT_SECRET=""
CMS_BLUE_BUTTON_MODE="sandbox"
SAM_GOV_API_KEY=""

# Secure private evidence storage for credentials/contracts. Use a BAA-capable deployment if PHI may be stored.
OBJECT_STORAGE_ENDPOINT=""
OBJECT_STORAGE_BUCKET=""
OBJECT_STORAGE_ACCESS_KEY_ID=""
OBJECT_STORAGE_SECRET_ACCESS_KEY=""

# Optional GRID agreement/signature and screening adapters. Vendor selection may change; keep behind gateway abstractions.
ESIGN_PROVIDER=""
ESIGN_API_KEY=""
BACKGROUND_CHECK_API_KEY=""

# Telemedicine.
DAILY_API_KEY=""

# Klinikos commercial/platform tenant. Platform fee policy and settlement writes are restricted to this organization.
# Keep the legacy sales slug aligned until the tenant is renamed in persisted data.
KLINIKOS_PLATFORM_ORGANIZATION_SLUG="clinicos-by-zumi"
CLINICOS_SALES_ORGANIZATION_SLUG="clinicos-by-zumi"
