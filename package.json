{
  "name": "zumi-clinicos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "node scripts/capture-release.mjs && prisma generate && next build",
    "postinstall": "node scripts/postinstall.mjs",
    "render:build": "node scripts/render-build.mjs",
    "release:status": "node scripts/release/check-production-currency.mjs",
    "start": "node scripts/start.mjs",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:mvp": "node scripts/mvp/run-all.mjs",
    "security:client-boundary": "node scripts/security/browser-confidentiality-gate.mjs",
    "security:env-boundary": "node scripts/security/server-env-taint-gate.mjs",
    "security:api-disclosure": "node scripts/security/api-disclosure-gate.mjs",
    "security:check": "npm run security:client-boundary && npm run security:env-boundary && npm run security:api-disclosure",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:validate": "prisma validate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:sales-demo": "tsx scripts/seed-sales-demo.ts",
    "verify:release": "node scripts/verify-release.mjs",
    "verify:code": "node scripts/verify-release.mjs --code-only",
    "verify:production": "node scripts/verify-production.mjs",
    "db:seed:grid-demo": "tsx scripts/seed-grid-demo.ts"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.6",
    "@prisma/client": "^6.14.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tailwindcss/postcss": "^4.1.12",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "fflate": "^0.8.3",
    "framer-motion": "^12.23.12",
    "jose": "^6.2.3",
    "lucide-react": "^0.539.0",
    "next": "15.5.22",
    "pdf-lib": "^1.17.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "recharts": "^3.1.2",
    "stripe": "^22.5.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.12",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/node": "^22.17.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "eslint": "^9.33.0",
    "eslint-config-next": "15.5.22",
    "postcss": "8.5.25",
    "prisma": "^6.14.0",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "postcss": "$postcss",
    "sharp": "0.35.3"
  }
}
