// Canonical person-level authentication substrate.
//
// Account is intentionally organization-agnostic. Organization authority remains an
// effective-dated relationship and is narrowed through a verified clinic context.
// Legacy User/AuthCredential/AuthSession stay in place during the migration window.

model Account {
  id              String                  @id @default(cuid())
  personId        String                  @unique
  primaryEmail    String                  @unique
  displayName     String
  status          String                  @default("active")
  emailVerifiedAt DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  person          Person                  @relation(fields: [personId], references: [id], onDelete: Restrict)
  credential      AccountCredential?
  sessions        AccountSession[]
  legacyLinks     LegacyUserAccountLink[]
  events          AccountEvent[]

  @@index([status])
  @@map("accounts")
}

model AccountCredential {
  id                String   @id @default(cuid())
  accountId         String   @unique
  passwordHash      String
  passwordChangedAt DateTime @default(now())
  mustReset         Boolean  @default(false)
  failedAttempts    Int      @default(0)
  lockedUntil       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  account           Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("account_credentials")
}

model AccountSession {
  id          String    @id
  accountId   String
  expiresAt   DateTime
  lastSeenAt  DateTime  @default(now())
  revokedAt   DateTime?
  ipAddress   String?
  userAgent   String?
  deviceLabel String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  account     Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, revokedAt, expiresAt])
  @@map("account_sessions")
}

model LegacyUserAccountLink {
  id           String   @id @default(cuid())
  accountId    String
  legacyUserId String   @unique
  sourceType   String   @default("legacy_user")
  createdAt    DateTime @default(now())
  account      Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("legacy_user_account_links")
}

// AccountEvent is neutral account-lifecycle evidence for person-level actions that
// happen before a real organization/tenant exists. It is not an authorization store,
// does not carry clinic roles, and must never be used as a substitute for tenant audit.
model AccountEvent {
  id              String   @id @default(cuid())
  accountId       String
  eventType       String
  sourceType      String
  sourceReference String?
  metadata        Json?
  createdAt       DateTime @default(now())
  account         Account  @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId, createdAt])
  @@index([eventType, createdAt])
  @@map("account_events")
}
