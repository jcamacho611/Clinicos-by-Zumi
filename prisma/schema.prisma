  patientId            String?
  requestingProviderId String
  consultantProviderId String?
  specialty            String
  clinicalQuestion     String
  priority             String       @default("routine")
  status               String       @default("requested")
  scheduledAt          DateTime?
  closedAt             DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status, specialty])
  @@map("provider_consultations")
}

model KnowledgeItem {
  id             String            @id @default(cuid())
  organizationId String?
  layer          String
  title          String
  content        String
  sourceName     String
  sourceUrl      String?
  sourceDate     DateTime?
  version        Int               @default(1)
  status         String            @default("draft")
  effectiveAt    DateTime?
  expiresAt      DateTime?
  supersedesId   String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization?     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reviews        KnowledgeReview[]

  @@index([organizationId, layer, status])
  @@map("knowledge_items")
}

model KnowledgeReview {
  id              String        @id @default(cuid())
  knowledgeItemId String
  reviewerId      String
  decision        String
  notes           String?
  reviewedAt      DateTime      @default(now())
  knowledgeItem   KnowledgeItem @relation(fields: [knowledgeItemId], references: [id], onDelete: Cascade)

  @@index([knowledgeItemId, reviewedAt])
  @@map("knowledge_reviews")
}

model RemoteObservation {
  id              String       @id @default(cuid())
  organizationId  String
  patientId       String
  type            String
  value           String
  unit            String?
  source          String
  observedAt      DateTime
  thresholdConfig Json?
  qualityFlag     String?
  reviewStatus    String       @default("pending")
  reviewedBy      String?
  reviewedAt      DateTime?
  createdAt       DateTime     @default(now())
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient         Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([organizationId, patientId, type, observedAt])
  @@map("remote_observations")
}

model InventoryItem {
  id               String                 @id @default(cuid())
  organizationId   String
  locationId       String?
  sku              String
  name             String
  category         String
  lotNumber        String?
  expiresAt        DateTime?
  quantityOnHand   Decimal                @default(0) @db.Decimal(12, 3)
  quantityReserved Decimal                @default(0) @db.Decimal(12, 3)
  reorderPoint     Decimal?               @db.Decimal(12, 3)
  unitCostCents    Int?
  status           String                 @default("active")
  serialNumber     String?
  vendor           String?
  controlledItem   Boolean                @default(false)
  coldChain        Boolean                @default(false)
  recallStatus     String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  organization     Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location         Location?              @relation(fields: [locationId], references: [id], onDelete: SetNull)
  transactions     InventoryTransaction[]

  @@unique([organizationId, sku, lotNumber])
  @@index([organizationId, locationId, status, expiresAt])
  @@map("inventory_items")
}

model InventoryTransaction {
  id              String        @id @default(cuid())
  organizationId  String
  inventoryItemId String
  type            String
  quantity        Decimal       @db.Decimal(12, 3)
  direction       String?
  note            String
  patientId       String?
  fromLocationId  String?
  toLocationId    String?
  actorId         String?
  status          String        @default("recorded")
  createdAt       DateTime      @default(now())
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([organizationId, inventoryItemId, type, createdAt])
  @@index([organizationId, patientId, createdAt])
  @@map("inventory_transactions")
}

model VoiceSession {
  id                   String       @id @default(cuid())
  organizationId       String
  userId               String?
  patientId            String?
  purpose              String
  language             String       @default("en-US")
  status               String       @default("draft")
  transcript           String?
  transcriptConfidence Float?
  provider             String
  consentConfirmedAt   DateTime?
  confirmedAt          DateTime?
  retentionExpiresAt   DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                 User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  patient              Patient?     @relation(fields: [patientId], references: [id], onDelete: SetNull)

  @@index([organizationId, userId, status, createdAt])
  @@map("voice_sessions")
}

model CopilotRun {
  id                   String    @id @default(cuid())
  organizationId       String
  userId               String
  patientId            String?
  inputMode            String    @default("typed")
  inputText            String
  intentKey            String
  category             String
  riskLevel            RiskLevel
  assignedTeam         String
  confidence           Decimal?  @db.Decimal(5, 4)
  status               String    @default("awaiting_review")
  engine               String    @default("deterministic_local")
  rulesVersion         String
  aiClassificationId   String?
  aiDraftId            String?
  voiceSessionId       String?
  requiresHumanReview  Boolean   @default(true)
  blockedFromExecution Boolean   @default(true)
  provenance           Json
  limitations          String[]
  reviewedBy           String?
  reviewedAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

