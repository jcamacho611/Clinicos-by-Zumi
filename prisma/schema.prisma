  slug            String                      @unique
  title           String
  mandate         String
  priority        String                      @default("P0")
  deliveryStatus  String
  deliveryMode    String
  interfaceRoute  String
  ownerRoles      String[]
  databaseObjects String[]
  featureCount    Int
  canonVersion    String
  immutable       Boolean                     @default(true)
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
  capabilities    FeatureRegistryCapability[]

  @@map("feature_registry_sections")
}

model FeatureRegistryCapability {
  id             String                 @id
  sectionId      String
  slug           String
  name           String
  priority       String                 @default("P0")
  deliveryStatus String
  deliveryMode   String
  completionPlan Json
  canonVersion   String
  immutable      Boolean                @default(true)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  section        FeatureRegistrySection @relation(fields: [sectionId], references: [id], onDelete: Restrict)

