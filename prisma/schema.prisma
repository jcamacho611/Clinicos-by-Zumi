generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RiskLevel {
  NORMAL
  NEEDS_STAFF
  NEEDS_PROVIDER
  URGENT
  DO_NOT_AUTOMATE
}

enum AccessLevel {
  INTERNAL
  PATIENT_VISIBLE
  RESTRICTED
}

enum AppointmentStatus {
  REQUESTED
  PENDING_CONFIRMATION
  CONFIRMED
  CHECKED_IN
  IN_ROOM
  WITH_PROVIDER
  CHECKOUT
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

enum EncounterStatus {
  DRAFT
  READY_FOR_REVIEW
  SIGNED
  LOCKED
  ADDENDUM_NEEDED
}

enum ClaimStatus {
  DRAFT
  READY_FOR_REVIEW
  SUBMITTED
  ACCEPTED
  REJECTED
  DENIED
  PAID
  PATIENT_BALANCE
  APPEALED
  CLOSED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
  INTERNAL
}

model Organization {
  id                         String                 @id @default(cuid())
  name                       String
  slug                       String                 @unique
  clinicType                 String
  status                     String                 @default("active")
  demoMode                   Boolean                @default(true)
  createdAt                  DateTime               @default(now())
  updatedAt                  DateTime               @updatedAt
  locations                  Location[]
  users                      User[]
  patients                   Patient[]
  appointments               Appointment[]
  encounters                 Encounter[]
  facilities                 Facility[]
  patientIdentifiers         PatientIdentifier[]
  patientMatches             PatientMatch[]
  accessGrants               AccessGrant[]
  recordRequests             RecordRequest[]
  resources                  ClinicResource[]
  subscriptions              ClinicSubscription[]
  careTeamRooms              CareTeamRoom[]
  episodeRooms               EpisodeRoom[]
  healthPassports            HealthPassport[]
  consentWallets             ConsentWallet[]
  intakePassports            IntakePassport[]
  careHandoffs               CareHandoff[]
  capacityListings           CapacityListing[]
  providerConsultations      ProviderConsultation[]
  knowledgeItems             KnowledgeItem[]
  remoteObservations         RemoteObservation[]
  inventoryItems             InventoryItem[]
  voiceSessions              VoiceSession[]
  outboundNetworkConnections NetworkConnection[]    @relation("NetworkSource")
  inboundNetworkConnections  NetworkConnection[]    @relation("NetworkTarget")
  outboundSharingAgreements  DataSharingAgreement[] @relation("SharingSource")
  inboundSharingAgreements   DataSharingAgreement[] @relation("SharingTarget")

  @@map("organizations")
}

model Location {
  id               String            @id @default(cuid())
  organizationId   String
  name             String
  address          Json?
  timezone         String            @default("America/New_York")
  status           String            @default("active")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  facilities       Facility[]
  resources        ClinicResource[]
  capacityListings CapacityListing[]
  inventoryItems   InventoryItem[]

  @@index([organizationId])
  @@map("locations")
}

model Department {
  id             String   @id @default(cuid())
  organizationId String
  locationId     String?
  name           String
  status         String   @default("active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@map("departments")
}

model User {
  id             String              @id @default(cuid())
  organizationId String
  email          String              @unique
  name           String
  roleKey        String
  status         String              @default("active")
  mfaEnabled     Boolean             @default(false)
  lastLoginAt    DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  authCredential AuthCredential?
  sessions       AuthSession[]
  passkeys       PasskeyCredential[]
  voiceSessions  VoiceSession[]

  @@index([organizationId])
  @@map("users")
}

model AuthCredential {
  id                String    @id @default(cuid())
  userId            String    @unique
  passwordHash      String
  passwordChangedAt DateTime  @default(now())
  mustReset         Boolean   @default(false)
  failedAttempts    Int       @default(0)
  lockedUntil       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_credentials")
}

model AuthSession {
  id          String    @id
  userId      String
  expiresAt   DateTime
  lastSeenAt  DateTime  @default(now())
  revokedAt   DateTime?
  ipAddress   String?
  userAgent   String?
  deviceLabel String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@map("auth_sessions")
}

model PasskeyCredential {
  id           String    @id @default(cuid())
  userId       String
  credentialId String    @unique
  publicKey    Bytes
  counter      BigInt    @default(0)
  transports   String[]
  deviceType   String?
  backedUp     Boolean   @default(false)
  nickname     String?
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("passkey_credentials")
}

model Role {
  id             String   @id @default(cuid())
  organizationId String?
  key            String
  name           String
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, key])
  @@map("roles")
}

model Permission {
  id        String   @id @default(cuid())
  roleId    String
  resource  String
  action    String
  allowed   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roleId])
  @@map("permissions")
}

model Provider {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  name           String
  credential     String
  specialty      String?
  npi            String?
  status         String   @default("active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@map("providers")
}

model ProviderCredential {
  id             String    @id @default(cuid())
  organizationId String
  providerId     String
  type           String
  number         String
  state          String?
  expiresAt      DateTime?
  status         String    @default("active")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([providerId])
  @@map("provider_credentials")
}

model Patient {
  id                  String              @id @default(cuid())
  organizationId      String
  locationId          String?
  mrn                 String
  masterPatientId     String?
  firstName           String
  lastName            String
  preferredName       String?
  formerNames         String[]            @default([])
  aliases             String[]            @default([])
  dateOfBirth         DateTime
  sexAtBirth          String?
  genderIdentity      String?
  pronouns            String?
  phone               String?
  email               String?
  preferredLanguage   String              @default("English")
  portalStatus        String              @default("inactive")
  identityStatus      String              @default("unverified")
  identityVerifiedAt  DateTime?
  identityVerifiedBy  String?
  communicationPrefs  Json?
  riskLevel           RiskLevel           @default(NORMAL)
  requiresHumanReview Boolean             @default(false)
  reviewedBy          String?
  reviewedAt          DateTime?
  status              String              @default("active")
  deceasedAt          DateTime?
  archivedAt          DateTime?
  createdBy           String?
  updatedBy           String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  organization        Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  appointments        Appointment[]
  encounters          Encounter[]
  identifiers         PatientIdentifier[]
  matchSources        PatientMatch[]      @relation("PatientMatchSource")
  matchCandidates     PatientMatch[]      @relation("PatientMatchCandidate")
  accessGrants        AccessGrant[]
  recordRequests      RecordRequest[]
  careTeamRooms       CareTeamRoom[]
  episodeRooms        EpisodeRoom[]
  healthPassport      HealthPassport?
  consentWallet       ConsentWallet?
  intakePassport      IntakePassport?
  careHandoffs        CareHandoff[]
  remoteObservations  RemoteObservation[]
  voiceSessions       VoiceSession[]

  @@unique([organizationId, mrn])
  @@index([masterPatientId])
  @@index([organizationId, lastName, firstName])
  @@map("patients")
}

model PatientContact {
  id             String   @id @default(cuid())
  organizationId String
  patientId      String
  type           String
  value          String
  preferred      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([patientId])
  @@map("patient_contacts")
}

model PatientInsurance {
  id              String    @id @default(cuid())
  organizationId  String
  patientId       String
  priority        Int       @default(1)
  payer           String
  planName        String?
  memberId        String
  groupNumber     String?
  effectiveDate   DateTime?
  terminationDate DateTime?
  status          String    @default("active")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([patientId])
  @@map("patient_insurance")
}

model PatientPharmacy {
  id             String   @id @default(cuid())
  organizationId String
  patientId      String
  name           String
  phone          String?
  address        Json?
  preferred      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([patientId])
  @@map("patient_pharmacies")
}

model PatientPreference {
  id             String   @id @default(cuid())
  organizationId String
  patientId      String
  key            String
  value          Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([patientId, key])
  @@map("patient_preferences")
}

model EmergencyContact {
  id             String   @id @default(cuid())
  organizationId String
  patientId      String
  name           String
  relationship   String
  phone          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([patientId])
  @@map("emergency_contacts")
}

model AppointmentType {
  id              String   @id @default(cuid())
  organizationId  String
  name            String
  durationMinutes Int
  color           String?
  telemedicine    Boolean  @default(false)
  status          String   @default("active")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
  @@map("appointment_types")
}

model Appointment {
  id                String            @id @default(cuid())
  organizationId    String
  locationId        String?
  patientId         String
  providerId        String?
  appointmentTypeId String?
  startsAt          DateTime
  endsAt            DateTime
  status            AppointmentStatus @default(REQUESTED)
  telemedicine      Boolean           @default(false)
  formsComplete     Boolean           @default(false)
  insuranceVerified Boolean           @default(false)
  paymentDueCents   Int               @default(0)
  notes             String?
  createdBy         String?
  updatedBy         String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  patient           Patient           @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([organizationId, startsAt])
  @@index([patientId, startsAt])
  @@map("appointments")
}

model ProviderAvailability {
  id             String   @id @default(cuid())
  organizationId String
  providerId     String
  locationId     String?
  weekday        Int
  startsAt       String
  endsAt         String
  recurrence     Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([providerId])
  @@map("provider_availability")
}

model Room {
  id             String   @id @default(cuid())
  organizationId String
  locationId     String
  name           String
  type           String?
  status         String   @default("active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([locationId])
  @@map("rooms")
}

model CheckIn {
  id             String    @id @default(cuid())
  organizationId String
  appointmentId  String
  arrivedAt      DateTime?
  roomedAt       DateTime?
  checkoutAt     DateTime?
  status         String    @default("pending")
  readiness      Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([appointmentId])
  @@map("check_ins")
}

model Waitlist {
  id                String   @id @default(cuid())
  organizationId    String
  patientId         String
  appointmentTypeId String?
  preferences       Json?
  status            String   @default("active")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([organizationId, status])
  @@map("waitlist")
}

model Encounter {
  id                  String          @id @default(cuid())
  organizationId      String
  locationId          String?
  patientId           String
  providerId          String?
  appointmentId       String?
  type                String
  serviceDate         DateTime
  status              EncounterStatus @default(DRAFT)
  chiefComplaint      String?
  hpi                 String?
  reviewOfSystems     Json?
  physicalExam        Json?
  assessment          String?
  plan                String?
  patientInstructions String?
  followUpPlan        String?
  requiresCosignature Boolean         @default(false)
  signedAt            DateTime?
  lockedAt            DateTime?
  createdBy           String?
  updatedBy           String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  organization        Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  patient             Patient         @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([patientId, serviceDate])
  @@index([organizationId, status])
  @@map("encounters")
}

model SoapNote {
  id             String          @id @default(cuid())
  organizationId String
  patientId      String
  encounterId    String
  subjective     String?
  objective      String?
  assessment     String?
  plan           String?
  status         EncounterStatus @default(DRAFT)
  signedBy       String?
  signedAt       DateTime?
  lockedAt       DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([encounterId])
  @@map("soap_notes")
}

model ClinicalNote {
  id             String          @id @default(cuid())
  organizationId String
  patientId      String
  encounterId    String?
  type           String
  content        Json
  status         EncounterStatus @default(DRAFT)
  signedBy       String?
  signedAt       DateTime?
  lockedAt       DateTime?
  addendumOfId   String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([patientId, createdAt])
  @@map("clinical_notes")
}

model NoteTemplate {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  encounterType  String?
  schema         Json
  status         String   @default("active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@map("note_templates")
}

model SmartPhrase {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  shortcut       String
  content        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, userId, shortcut])
  @@map("smart_phrases")
}

model Vital {
  id                     String   @id @default(cuid())
  organizationId         String
  patientId              String
  encounterId            String?
  measuredAt             DateTime @default(now())
  bloodPressureSystolic  Int?
  bloodPressureDiastolic Int?
  heartRate              Int?
  temperatureF           Decimal? @db.Decimal(4, 1)
  oxygenPercent          Int?
  weightLbs              Decimal? @db.Decimal(6, 2)
  heightInches           Decimal? @db.Decimal(5, 2)
  bmi                    Decimal? @db.Decimal(5, 2)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([patientId, measuredAt])
  @@map("vitals")
}

model Allergy {
  id             String   @id @default(cuid())
  organizationId String
  patientId      String
  substance      String
  reaction       String?
  severity       String?
  status         String   @default("active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([patientId])
  @@map("allergies")
}

model Medication {
  id             String    @id @default(cuid())
  organizationId String
  patientId      String
  name           String
  dose           String?
  frequency      String?
  route          String?
  startDate      DateTime?
  endDate        DateTime?
  status         String    @default("active")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([patientId, status])
  @@map("medications")
}

model Problem {
  id             String    @id @default(cuid())
  organizationId String
  patientId      String
  code           String?
  label          String
  onsetDate      DateTime?
  status         String    @default("active")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([patientId, status])
  @@map("problems")
}

model Diagnosis {
  id             String   @id @default(cuid())
  organizationId String
  patientId      String
  encounterId    String?
  codeSystem     String   @default("ICD-10-CM")
  code           String
  label          String
  primary        Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([encounterId])
  @@map("diagnoses")
}

model Procedure {
  id             String   @id @default(cuid())
  organizationId String
  patientId      String
  encounterId    String?
  codeSystem     String   @default("CPT")
  code           String
  label          String
  modifiers      String[]
  units          Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([encounterId])
  @@map("procedures")
}

model ClinicalOrder {
  id             String    @id @default(cuid())
  organizationId String
  patientId      String
  encounterId    String?
  providerId     String?
  type           String
  details        Json
  status         String    @default("draft")
  orderedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([patientId, type])
  @@map("orders")
}

model Referral {
  id                         String          @id @default(cuid())
  organizationId             String
  patientId                  String
  encounterId                String?
  orderId                    String?
  specialty                  String
  destination                String?
  destinationType            String          @default("external")
  destinationOrganizationId  String?
  destinationFacilityId      String?
  destinationProviderId      String?
  reason                     String?
  clinicalQuestion           String?
  priority                   String          @default("routine")
  authorizationStatus        String          @default("not_required")
  deliveryMethod             String          @default("manual")
  deliveryStatus             String          @default("not_started")
  deliveryAttempts           Int             @default(0)
  lastDeliveryAttemptAt      DateTime?
  failureReason              String?
  supportingDocumentIds      String[]        @default([])
  patientOutreachStatus      String          @default("not_started")
  patientNotifiedAt          DateTime?
  followUpDueAt              DateTime?
  assignedTo                 String?
  createdBy                  String?
  status                     String          @default("draft")
  sentAt                     DateTime?
  receivedAt                 DateTime?
  acceptedAt                 DateTime?
  declinedAt                 DateTime?
  declineReason              String?
  scheduledAt                DateTime?
  appointmentAt              DateTime?
  completedAt                DateTime?
  consultationNoteDocumentId String?
  consultationNoteReceivedAt DateTime?
  specialistResponse         String?
  closedLoopAt               DateTime?
  closedBy                   String?
  provenance                 Json?
  createdAt                  DateTime        @default(now())
  updatedAt                  DateTime        @updatedAt
  events                     ReferralEvent[]

  @@index([organizationId, status, followUpDueAt])
  @@index([destinationOrganizationId, status])
  @@index([patientId, createdAt])
  @@index([orderId])
  @@map("referrals")
}

model ReferralEvent {
  id             String   @id @default(cuid())
  organizationId String
  referralId     String
  actorId        String?
  eventType      String
  fromStatus     String?
  toStatus       String?
  deliveryMethod String?
  note           String?
  metadata       Json?
  createdAt      DateTime @default(now())
  referral       Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)

  @@index([organizationId, referralId, createdAt])
  @@index([referralId, createdAt])
  @@map("referral_events")
}

model Immunization {
  id             String    @id @default(cuid())
  organizationId String
  patientId      String
  vaccine        String
  cvxCode        String?
  administeredAt DateTime?
  lotNumber      String?
  status         String    @default("complete")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([patientId])
  @@map("immunizations")
}

model CarePlan {
  id             String   @id @default(cuid())
  organizationId String
  patientId      String
  title          String
  goals          Json?
  interventions  Json?
  status         String   @default("active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([patientId])
  @@map("care_plans")
}

model PatientInstruction {
  id             String    @id @default(cuid())
  organizationId String
  patientId      String
  encounterId    String?
  content        String
  patientVisible Boolean   @default(true)
  releasedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([patientId])
  @@map("patient_instructions")
}

model DocumentCategory {
  id             String      @id @default(cuid())
  organizationId String
  name           String
  defaultAccess  AccessLevel @default(INTERNAL)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([organizationId, name])
  @@map("document_categories")
}

model Document {
  id             String      @id @default(cuid())
  organizationId String
  patientId      String?
  categoryId     String?
  name           String
  storageKey     String
  mimeType       String
  sizeBytes      Int
  accessLevel    AccessLevel @default(INTERNAL)
  patientVisible Boolean     @default(false)
  internalOnly   Boolean     @default(true)
  lockedAt       DateTime?
  uploadedBy     String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([patientId, createdAt])
  @@map("documents")
}

model DocumentReview {
  id             String    @id @default(cuid())
  organizationId String
  documentId     String
  reviewerId     String?
  status         String    @default("needs_review")
  notes          String?
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([documentId])
  @@map("document_reviews")
}

model FormTemplate {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  version        Int      @default(1)
  schema         Json
  status         String   @default("active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, status])
  @@map("form_templates")
}

model FormSubmission {
  id              String      @id @default(cuid())
  organizationId  String
  patientId       String
  templateId      String
  templateVersion Int
  answers         Json
  status          String      @default("incomplete")
  accessLevel     AccessLevel @default(INTERNAL)
  reviewedBy      String?
  reviewedAt      DateTime?
  lockedAt        DateTime?
  submittedAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([patientId, status])
  @@map("form_submissions")
}

model Consent {
  id                      String    @id @default(cuid())
  organizationId          String
  patientId               String
  templateId              String?
  type                    String
  version                 Int
  purposeOfUse            String?
  dataCategories          String[]  @default([])
  grantedToOrganizationId String?
  grantedToUserId         String?
  sensitiveRestrictions   Json?
  source                  String    @default("staff_capture")
  signerName              String?
  signerRelationship      String?
  capturedBy              String?
  documentId              String?
  status                  String    @default("pending")
  effectiveAt             DateTime?
  signedAt                DateTime?
  expiresAt               DateTime?
  withdrawnAt             DateTime?
  withdrawnBy             String?
  withdrawalReason        String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([patientId, type])
  @@index([organizationId, status, expiresAt])
  @@index([grantedToOrganizationId, purposeOfUse, status])
  @@map("consents")
}

model Signature {
  id             String   @id @default(cuid())
  organizationId String
  patientId      String?
  userId         String?
  entityType     String
  entityId       String
  signerName     String
  signatureHash  String
  context        Json?
  signedAt       DateTime @default(now())
  createdAt      DateTime @default(now())

  @@index([entityType, entityId])
  @@map("signatures")
}

model LabOrder {
  id             String    @id @default(cuid())
  organizationId String
  patientId      String
  encounterId    String?
  providerId     String?
  vendor         String?
