model CareTeamRoom {
  id             String           @id @default(cuid())
  organizationId String
  patientId      String
  name           String
  sourceType     String
  sourceId       String?
  status         String           @default("active")
  sharedPlan     Json?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient        Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  members        CareTeamMember[]

  @@index([organizationId, patientId, status])
  @@map("care_team_rooms")
}

model CareTeamMember {
  id                        String       @id @default(cuid())
  careTeamRoomId            String
  representedOrganizationId String
  userId                    String?
  providerId                String?
  role                      String
  accessLevel               String       @default("minimum_necessary")
  status                    String       @default("invited")
  joinedAt                  DateTime?
  removedAt                 DateTime?
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt
  careTeamRoom              CareTeamRoom @relation(fields: [careTeamRoomId], references: [id], onDelete: Cascade)

  @@index([careTeamRoomId, status])
  @@map("care_team_members")
}

model EpisodeRoom {
  id              String       @id @default(cuid())
  organizationId  String
  patientId       String
  type            String
  caseId          String?
  title           String
  status          String       @default("open")
  readinessScore  Int          @default(0)
  nextAction      String?
  responsibleRole String?
  riskLevel       RiskLevel    @default(NORMAL)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient         Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([organizationId, patientId, status])
  @@map("episode_rooms")
}

model HealthPassport {
  id              String       @id @default(cuid())
  organizationId  String
  patientId       String       @unique
  status          String       @default("active")
  summary         Json
  lastConfirmedAt DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient         Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@map("health_passports")
}

model ConsentWallet {
  id                  String       @id @default(cuid())
  organizationId      String
  patientId           String       @unique
  sharingDefaults     Json
  emergencyPreference String?
  recoveryStatus      String       @default("active")
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient             Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("consent_wallets")
}

model IntakePassport {
  id             String       @id @default(cuid())
  organizationId String
  patientId      String       @unique
  reusableFields Json
  confirmedAt    DateTime?
  version        Int          @default(1)
  status         String       @default("active")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient        Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@map("intake_passports")
}

model CareHandoff {
  id              String       @id @default(cuid())
  organizationId  String
  patientId       String
  senderId        String
  receiverId      String
  type            String
  summary         Json
  requestedAction String
  priority        String       @default("normal")
  dueAt           DateTime?
  status          String       @default("sent")
  acknowledgedAt  DateTime?
  resolvedAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient         Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([organizationId, patientId, status, dueAt])
  @@map("care_handoffs")
}

model CapacityListing {
  id             String       @id @default(cuid())
  organizationId String
  locationId     String?
  facilityId     String?
  type           String
  service        String
  startsAt       DateTime
  endsAt         DateTime
  acceptedPayers String[]
  urgencyLevels  String[]
  status         String       @default("open")
  metadata       Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location       Location?    @relation(fields: [locationId], references: [id], onDelete: SetNull)
  facility       Facility?    @relation(fields: [facilityId], references: [id], onDelete: SetNull)

  @@index([organizationId, type, service, startsAt, status])
  @@map("capacity_listings")
}

model ProviderConsultation {
  id                   String       @id @default(cuid())
  organizationId       String
  patientId            String?
  requestingProviderId String
  consultantProviderId String?
  specialty            String
  clinicalQuestion     String
  priority             String       @default("routine")
  status               String       @default("requested")
  scheduledAt          DateTime?
  closedAt             DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status, specialty])
  @@map("provider_consultations")
}

model KnowledgeItem {
  id             String            @id @default(cuid())
  organizationId String?
  layer          String
  title          String
  content        String
  sourceName     String
  sourceUrl      String?
  sourceDate     DateTime?
  version        Int               @default(1)
  status         String            @default("draft")
  effectiveAt    DateTime?
  expiresAt      DateTime?
  supersedesId   String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization?     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reviews        KnowledgeReview[]

  @@index([organizationId, layer, status])
  @@map("knowledge_items")
}

model KnowledgeReview {
  id              String        @id @default(cuid())
  knowledgeItemId String
  reviewerId      String
  decision        String
  notes           String?
  reviewedAt      DateTime      @default(now())
  knowledgeItem   KnowledgeItem @relation(fields: [knowledgeItemId], references: [id], onDelete: Cascade)

  @@index([knowledgeItemId, reviewedAt])
  @@map("knowledge_reviews")
}

model RemoteObservation {
  id             String       @id @default(cuid())
  organizationId String
  patientId      String
  type           String
  value          String
  unit           String?
  source         String
  observedAt     DateTime
  qualityFlag    String?
  reviewStatus   String       @default("pending")
  reviewedBy     String?
  reviewedAt     DateTime?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient        Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([organizationId, patientId, type, observedAt])
  @@map("remote_observations")
}

model InventoryItem {
  id               String       @id @default(cuid())
  organizationId   String
  locationId       String?
  sku              String
  name             String
  category         String
  lotNumber        String?
  expiresAt        DateTime?
  quantityOnHand   Decimal      @default(0) @db.Decimal(12, 3)
  quantityReserved Decimal      @default(0) @db.Decimal(12, 3)
  reorderPoint     Decimal?     @db.Decimal(12, 3)
  unitCostCents    Int?
  status           String       @default("active")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location         Location?    @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@unique([organizationId, sku, lotNumber])
  @@index([organizationId, locationId, status, expiresAt])
  @@map("inventory_items")
}

model VoiceSession {
  id                   String       @id @default(cuid())
  organizationId       String
  userId               String?
  patientId            String?
  purpose              String
  language             String       @default("en-US")
  status               String       @default("draft")
  transcript           String?
  transcriptConfidence Float?
  provider             String
  consentConfirmedAt   DateTime?
  confirmedAt          DateTime?
  retentionExpiresAt   DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                 User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  patient              Patient?     @relation(fields: [patientId], references: [id], onDelete: SetNull)

  @@index([organizationId, userId, status, createdAt])
  @@map("voice_sessions")
}

model FeatureRegistrySection {
  id              String                      @id
  number          Int                         @unique
  slug            String                      @unique
  title           String
  mandate         String
  priority        String                      @default("P0")
  deliveryStatus  String
  deliveryMode    String
  interfaceRoute  String
  ownerRoles      String[]
  databaseObjects String[]
  featureCount    Int
  canonVersion    String
  immutable       Boolean                     @default(true)
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
  capabilities    FeatureRegistryCapability[]

  @@map("feature_registry_sections")
}

model FeatureRegistryCapability {
  id             String                 @id
  sectionId      String
  slug           String
  name           String
  priority       String                 @default("P0")
  deliveryStatus String
  deliveryMode   String
  completionPlan Json
  canonVersion   String
  immutable      Boolean                @default(true)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  section        FeatureRegistrySection @relation(fields: [sectionId], references: [id], onDelete: Restrict)

  @@unique([sectionId, slug])
  @@index([deliveryStatus, priority])
  @@map("feature_registry_capabilities")
}
