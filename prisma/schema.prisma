generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RiskLevel {
  NORMAL
  NEEDS_STAFF
  NEEDS_PROVIDER
  URGENT
  DO_NOT_AUTOMATE
}

enum AccessLevel {
  INTERNAL
  PATIENT_VISIBLE
  RESTRICTED
}

enum AppointmentStatus {
  REQUESTED
  PENDING_CONFIRMATION
  CONFIRMED
  CHECKED_IN
  IN_ROOM
  WITH_PROVIDER
  CHECKOUT
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

enum EncounterStatus {
  DRAFT
  READY_FOR_REVIEW
  SIGNED
  LOCKED
  ADDENDUM_NEEDED
}

enum ClaimStatus {
  DRAFT
  READY_FOR_REVIEW
  SUBMITTED
  ACCEPTED
  REJECTED
  DENIED
  PAID
  PATIENT_BALANCE
  APPEALED
  CLOSED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
  INTERNAL
}

model AccessGateAcceptance {
  id              String   @id @default(cuid())
  email           String
  documentKey     String
  documentVersion String
  acceptedAt      DateTime @default(now())
  ipAddress       String?
  userAgent       String?
  source          String   @default("web-access-gate")
  createdAt       DateTime @default(now())

  @@index([email, documentKey])
  @@index([acceptedAt])
  @@map("access_gate_acceptances")
}

model Organization {
  id                         String                      @id @default(cuid())
  name                       String
  slug                       String                      @unique
  clinicType                 String
  status                     String                      @default("active")
  demoMode                   Boolean                     @default(true)
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  locations                  Location[]
  users                      User[]
  portalAccounts             PortalAccount[]
  patients                   Patient[]
  appointments               Appointment[]
  encounters                 Encounter[]
  facilities                 Facility[]
  patientIdentifiers         PatientIdentifier[]
  patientMatches             PatientMatch[]
  accessGrants               AccessGrant[]
  recordRequests             RecordRequest[]
  resources                  ClinicResource[]
  subscriptions              ClinicSubscription[]
  careTeamRooms              CareTeamRoom[]
  episodeRooms               EpisodeRoom[]
  healthPassports            HealthPassport[]
  consentWallets             ConsentWallet[]
  intakePassports            IntakePassport[]
  careHandoffs               CareHandoff[]               @relation("CareHandoffSource")
  receivedCareHandoffs       CareHandoff[]               @relation("CareHandoffDestination")
  careHandoffEvents          CareHandoffEvent[]
  capacityListings           CapacityListing[]
  providerConsultations      ProviderConsultation[]
  providerFacilityPrivileges ProviderFacilityPrivilege[]
  knowledgeItems             KnowledgeItem[]
  remoteObservations         RemoteObservation[]
  inventoryItems             InventoryItem[]
  inventoryTransactions      InventoryTransaction[]
  leads                      Lead[]
  leadEvents                 LeadEvent[]
  prospectDemoReservations   DemoReservation[]           @relation("ProspectDemoOrganization")
  managedDemoReservations    DemoReservation[]           @relation("SalesOwnerOrganization")
  salesDemoScenarios         DemoScenario[]              @relation("SalesScenarioOwner")
  salesDemoRecaps            DemoRecap[]                 @relation("SalesRecapOwner")
  salesDemoEvents            DemoReservationEvent[]      @relation("SalesEventOwner")
  reliabilityEvents          ReliabilityEvent[]
  voiceSessions              VoiceSession[]
  outboundNetworkConnections NetworkConnection[]         @relation("NetworkSource")
  inboundNetworkConnections  NetworkConnection[]         @relation("NetworkTarget")
  sentNetworkInvitations     NetworkInvitation[]         @relation("InvitationSource")
  receivedNetworkInvitations NetworkInvitation[]         @relation("InvitationTarget")
  outboundSharingAgreements  DataSharingAgreement[]      @relation("SharingSource")
  inboundSharingAgreements   DataSharingAgreement[]      @relation("SharingTarget")
  providers                  Provider[]
  providerAvailabilities     ProviderAvailability[]
  gridServiceListings        GridServiceListing[]
  gridRequestsSent           GridRequest[]               @relation("GridRequestOrigin")
  gridRequestsReceived       GridRequest[]               @relation("GridRequestDestination")
  gridRequestEvents          GridRequestEvent[]
  gridPayouts                GridPayout[]

  @@map("organizations")
}

model Location {
  id                     String                 @id @default(cuid())
  organizationId         String
  name                   String
  address                Json?
  city                   String?
  state                  String?
  zip                    String?
  timezone               String                 @default("America/New_York")
  locationType           String                 @default("clinic")
  roomTypes              String[]               @default([])
  chairRentalAvailable   Boolean                @default(false)
  hourlyRateCents        Int?
  dailyRateCents         Int?
  servicesAllowed        String[]               @default([])
  credentialRequirements String[]               @default([])
  insuranceRequirements  String[]               @default([])
  marketplaceVisible     Boolean                @default(false)
  status                 String                 @default("active")
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  organization           Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  facilities             Facility[]
  resources              ClinicResource[]
  capacityListings       CapacityListing[]
  inventoryItems         InventoryItem[]
  providerAvailabilities ProviderAvailability[]
  gridRequests           GridRequest[]

  @@index([organizationId])
  @@map("locations")
}

model Department {
  id             String   @id @default(cuid())
  organizationId String
  locationId     String?
  name           String
  status         String   @default("active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@map("departments")
}

model User {
  id             String              @id @default(cuid())
  organizationId String
  email          String              @unique
  name           String
  roleKey        String
  status         String              @default("active")
  mfaEnabled     Boolean             @default(false)
  lastLoginAt    DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  authCredential AuthCredential?
  sessions       AuthSession[]
  passkeys       PasskeyCredential[]
  voiceSessions  VoiceSession[]
  provider       Provider?

  @@index([organizationId])
  @@map("users")
}

model AuthCredential {
  id                String    @id @default(cuid())
  userId            String    @unique
  passwordHash      String
  passwordChangedAt DateTime  @default(now())
  mustReset         Boolean   @default(false)
  failedAttempts    Int       @default(0)
  lockedUntil       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_credentials")
}

model PortalAccount {
  id              String          @id @default(cuid())
  organizationId  String
  patientId       String          @unique
  email           String
  passwordHash    String
  status          String          @default("active")
  emailVerifiedAt DateTime?
  mfaEnabled      Boolean         @default(false)
  mustReset       Boolean         @default(false)
  failedAttempts  Int             @default(0)
  lockedUntil     DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  patient         Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  sessions        PortalSession[]

  @@unique([organizationId, email])
  @@index([email, status])
  @@map("portal_accounts")
}

model PortalSession {
  id              String        @id
  portalAccountId String
  expiresAt       DateTime
  lastSeenAt      DateTime      @default(now())
  revokedAt       DateTime?
  ipAddress       String?
  userAgent       String?
  deviceLabel     String?
  authLevel       String        @default("password")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  portalAccount   PortalAccount @relation(fields: [portalAccountId], references: [id], onDelete: Cascade)

  @@index([portalAccountId, revokedAt, expiresAt])
  @@map("portal_sessions")
}

model AuthSession {
  id          String    @id
  userId      String
  expiresAt   DateTime
  lastSeenAt  DateTime  @default(now())
  revokedAt   DateTime?
  ipAddress   String?
  userAgent   String?
  deviceLabel String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@map("auth_sessions")
}

model PasskeyCredential {
  id           String    @id @default(cuid())
  userId       String
  credentialId String    @unique
  publicKey    Bytes
  counter      BigInt    @default(0)
  transports   String[]
  deviceType   String?
  backedUp     Boolean   @default(false)
  nickname     String?
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("passkey_credentials")
}

model Role {
  id             String   @id @default(cuid())
  organizationId String?
  key            String
  name           String
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, key])
  @@map("roles")
}

model Permission {
  id        String   @id @default(cuid())
  roleId    String
  resource  String
  action    String
  allowed   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roleId])
  @@map("permissions")
}

model Provider {
  id                             String                      @id @default(cuid())
  organizationId                 String
  userId                         String?                     @unique
  name                           String
  displayName                    String
  legalName                      String
  engagementType                 String                      @default("staff")
  contactEmail                   String?
  contactPhone                   String?
  credential                     String
  providerType                   String
  specialty                      String?
  subspecialty                   String?
  taxonomy                       String?
  npi                            String?
  deaNumber                      String?
  deaExpiresAt                   DateTime?
  malpracticeCarrier             String?
  malpracticePolicyNumber        String?
  malpracticeExpiration          DateTime?
  malpracticeCoverageAmountCents Int?
  malpracticeEvidenceReference   String?
  malpracticeVerificationStatus  String                      @default("pending")
  malpracticeVerifiedAt          DateTime?
  malpracticeVerifiedBy          String?
  malpracticeReviewNotes         String?
  certifications                 String[]                    @default([])
  servicesOffered                String[]                    @default([])
  experienceLevel                String                      @default("Entry")
  bio                            String?
  profilePhoto                   String?
  serviceLocations               String[]                    @default([])
  mobileServiceAllowed           Boolean                     @default(false)
  chairRentalAllowed             Boolean                     @default(false)
  atHomeAllowed                  Boolean                     @default(false)
  travelRadiusMiles              Int                         @default(0)
  onCallNow                      Boolean                     @default(false)
  verificationStatus             String                      @default("draft")
  applicationSubmittedAt         DateTime?
  approvedBy                     String?
  approvedAt                     DateTime?
  renewalDueAt                   DateTime?
  telemedicineEligible           Boolean                     @default(false)
  prescribingEligible            Boolean                     @default(false)
  acceptedInsurance              String[]                    @default([])
  services                       String[]                    @default([])
  status                         String                      @default("active")
  createdAt                      DateTime                    @default(now())
  updatedAt                      DateTime                    @updatedAt
  organization                   Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                           User?                       @relation(fields: [userId], references: [id], onDelete: SetNull)
  facilityPrivileges             ProviderFacilityPrivilege[]
  credentials                    ProviderCredential[]
  availability                   ProviderAvailability[]
  gridServiceListings            GridServiceListing[]
  gridRequests                   GridRequest[]
  gridPayouts                    GridPayout[]

  @@index([organizationId, status, verificationStatus])
  @@index([providerType, verificationStatus])
  @@map("providers")
}

model ProviderCredential {
  id                      String    @id @default(cuid())
  organizationId          String
  providerId              String
  type                    String
  number                  String
  state                   String?
  expiresAt               DateTime?
  status                  String    @default("active")
  verificationStatus      String    @default("pending")
  verificationSource      String?
  primarySourceVerifiedAt DateTime?
  evidenceDocumentId      String?
  evidenceReference       String?
  exceptionReason         String?
  verifiedBy              String?
  reviewNotes             String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  provider                Provider  @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@map("provider_credentials")
}

model ProviderFacilityPrivilege {
  id                 String       @id @default(cuid())
  organizationId     String
  providerId         String
  facilityId         String
  status             String       @default("pending")
  grantedAt          DateTime?
  expiresAt          DateTime?
  verificationSource String?
  notes              String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider           Provider     @relation(fields: [providerId], references: [id], onDelete: Cascade)
  facility           Facility     @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@unique([organizationId, providerId, facilityId])
  @@index([organizationId, status, expiresAt])
  @@map("provider_facility_privileges")
}

model Patient {
  id                  String              @id @default(cuid())
  organizationId      String
  locationId          String?
  mrn                 String
  masterPatientId     String?
  firstName           String
  lastName            String
  preferredName       String?
  formerNames         String[]            @default([])
  aliases             String[]            @default([])
  dateOfBirth         DateTime
  sexAtBirth          String?
  genderIdentity      String?
  pronouns            String?
  phone               String?
  email               String?
  preferredLanguage   String              @default("English")
  portalStatus        String              @default("inactive")
  identityStatus      String              @default("unverified")
  identityVerifiedAt  DateTime?
  identityVerifiedBy  String?
  communicationPrefs  Json?
  riskLevel           RiskLevel           @default(NORMAL)
  requiresHumanReview Boolean             @default(false)
  reviewedBy          String?
  reviewedAt          DateTime?
  status              String              @default("active")
  deceasedAt          DateTime?
  archivedAt          DateTime?
  createdBy           String?
  updatedBy           String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  organization        Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  appointments        Appointment[]
  encounters          Encounter[]
  identifiers         PatientIdentifier[]
  matchSources        PatientMatch[]      @relation("PatientMatchSource")
  matchCandidates     PatientMatch[]      @relation("PatientMatchCandidate")
  accessGrants        AccessGrant[]
  recordRequests      RecordRequest[]
  careTeamRooms       CareTeamRoom[]
  episodeRooms        EpisodeRoom[]
  healthPassport      HealthPassport?
  consentWallet       ConsentWallet?
  intakePassport      IntakePassport?
  careHandoffs        CareHandoff[]
  gridRequests        GridRequest[]
  remoteObservations  RemoteObservation[]
  voiceSessions       VoiceSession[]
  leads               Lead[]
  portalAccount       PortalAccount?

  @@unique([organizationId, mrn])
  @@index([organizationId, lastName, firstName])
  @@map("patients")
}
