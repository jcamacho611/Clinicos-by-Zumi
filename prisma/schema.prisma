generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RiskLevel {
  NORMAL
  NEEDS_STAFF
  NEEDS_PROVIDER
  URGENT
  DO_NOT_AUTOMATE
}

enum AccessLevel {
  INTERNAL
  PATIENT_VISIBLE
  RESTRICTED
}

enum AppointmentStatus {
  REQUESTED
  PENDING_CONFIRMATION
  CONFIRMED
  CHECKED_IN
  IN_ROOM
  WITH_PROVIDER
  CHECKOUT
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

enum EncounterStatus {
  DRAFT
  READY_FOR_REVIEW
  SIGNED
  LOCKED
  ADDENDUM_NEEDED
}

enum ClaimStatus {
  DRAFT
  READY_FOR_REVIEW
  SUBMITTED
  ACCEPTED
  REJECTED
  DENIED
  PAID
  PATIENT_BALANCE
  APPEALED
  CLOSED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
  INTERNAL
}

model AccessGateAcceptance {
  id              String    @id @default(cuid())
  email           String
  documentKey     String
  documentVersion String
  acceptedAt      DateTime  @default(now())
  verifiedEmailAt DateTime?
  ipAddress       String?
  userAgent       String?
  source          String    @default("web-access-gate")
  createdAt       DateTime  @default(now())

  @@index([email, documentKey])
  @@index([acceptedAt])
  @@index([verifiedEmailAt])
  @@map("access_gate_acceptances")
}

model Organization {
  id                         String                      @id @default(cuid())
  name                       String
  slug                       String                      @unique
  clinicType                 String
  status                     String                      @default("active")
  demoMode                   Boolean                     @default(true)
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  locations                  Location[]
  users                      User[]
  portalAccounts             PortalAccount[]
  patients                   Patient[]
  appointments               Appointment[]
  encounters                 Encounter[]
  facilities                 Facility[]
  patientIdentifiers         PatientIdentifier[]
  patientMatches             PatientMatch[]
  accessGrants               AccessGrant[]
  recordRequests             RecordRequest[]
  resources                  ClinicResource[]
  subscriptions              ClinicSubscription[]
  careTeamRooms              CareTeamRoom[]
  episodeRooms               EpisodeRoom[]
  healthPassports            HealthPassport[]
  consentWallets             ConsentWallet[]
  intakePassports            IntakePassport[]
  careHandoffs               CareHandoff[]               @relation("CareHandoffSource")
  receivedCareHandoffs       CareHandoff[]               @relation("CareHandoffDestination")
  careHandoffEvents          CareHandoffEvent[]
  capacityListings           CapacityListing[]
  providerConsultations      ProviderConsultation[]
  providerFacilityPrivileges ProviderFacilityPrivilege[]
  knowledgeItems             KnowledgeItem[]
  remoteObservations         RemoteObservation[]
  inventoryItems             InventoryItem[]
  inventoryTransactions      InventoryTransaction[]
  leads                      Lead[]
  leadEvents                 LeadEvent[]
  prospectDemoReservations   DemoReservation[]           @relation("ProspectDemoOrganization")
  managedDemoReservations    DemoReservation[]           @relation("SalesOwnerOrganization")
  salesDemoScenarios         DemoScenario[]              @relation("SalesScenarioOwner")
  salesDemoRecaps            DemoRecap[]                 @relation("SalesRecapOwner")
  salesDemoEvents            DemoReservationEvent[]      @relation("SalesEventOwner")
  reliabilityEvents          ReliabilityEvent[]
  voiceSessions              VoiceSession[]
  outboundNetworkConnections NetworkConnection[]         @relation("NetworkSource")
  inboundNetworkConnections  NetworkConnection[]         @relation("NetworkTarget")
  sentNetworkInvitations     NetworkInvitation[]         @relation("InvitationSource")
  receivedNetworkInvitations NetworkInvitation[]         @relation("InvitationTarget")
  outboundSharingAgreements  DataSharingAgreement[]      @relation("SharingSource")
  inboundSharingAgreements   DataSharingAgreement[]      @relation("SharingTarget")
  providers                  Provider[]
  providerAvailabilities     ProviderAvailability[]
  gridServiceListings        GridServiceListing[]
  gridRequestsSent           GridRequest[]               @relation("GridRequestOrigin")
  gridRequestsReceived       GridRequest[]               @relation("GridRequestDestination")
  gridRequestEvents          GridRequestEvent[]
  gridPayouts                GridPayout[]
  companyExternalOpportunities CompanyExternalOpportunity[]

  @@map("organizations")
}

model Location {
  id                     String                 @id @default(cuid())
  organizationId         String
  name                   String
  address                Json?
  city                   String?
  state                  String?
  zip                    String?
  timezone               String                 @default("America/New_York")
  locationType           String                 @default("clinic")
  roomTypes              String[]               @default([])
  chairRentalAvailable   Boolean                @default(false)
  hourlyRateCents        Int?
  dailyRateCents         Int?
  servicesAllowed        String[]               @default([])
  credentialRequirements String[]               @default([])
  insuranceRequirements  String[]               @default([])
  marketplaceVisible     Boolean                @default(false)
  status                 String                 @default("active")
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  organization           Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  facilities             Facility[]
  resources              ClinicResource[]
  capacityListings       CapacityListing[]
  inventoryItems         InventoryItem[]
  providerAvailabilities ProviderAvailability[]
  gridRequests           GridRequest[]

  @@index([organizationId])
  @@map("locations")
}

model Department {
  id             String   @id @default(cuid())
  organizationId String
  locationId     String?
  name           String
  status         String   @default("active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@map("departments")
}

model User {
  id             String              @id @default(cuid())
  organizationId String
  email          String              @unique
  name           String
  roleKey        String
  status         String              @default("active")
  mfaEnabled     Boolean             @default(false)
  lastLoginAt    DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  authCredential AuthCredential?
  sessions       AuthSession[]
  passkeys       PasskeyCredential[]
  voiceSessions  VoiceSession[]
  provider       Provider?
  companyOpportunityOwnerships CompanyExternalOpportunity[] @relation("CompanyOpportunityOwner")
  companyOpportunityCreations CompanyExternalOpportunity[] @relation("CompanyOpportunityCreator")
  companyOpportunityEvidenceObservations CompanyOpportunityEvidence[] @relation("CompanyOpportunityEvidenceObserver")
  companyOpportunityEvidenceVerifications CompanyOpportunityEvidence[] @relation("CompanyOpportunityEvidenceVerifier")
  companyOpportunityEvidenceApprovals CompanyOpportunityEvidence[] @relation("CompanyOpportunityEvidenceApprover")
  companyOpportunityEvidenceRecordings CompanyOpportunityEvidence[] @relation("CompanyOpportunityEvidenceRecorder")
  companyOpportunityEvents CompanyOpportunityEvent[] @relation("CompanyOpportunityEventActor")

  @@index([organizationId])
  @@map("users")
}

model AuthCredential {
  id                String    @id @default(cuid())
  userId            String    @unique
  passwordHash      String
  passwordChangedAt DateTime  @default(now())
  mustReset         Boolean   @default(false)
  failedAttempts    Int       @default(0)
  lockedUntil       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_credentials")
}

model PortalAccount {
  id              String          @id @default(cuid())
  organizationId  String
  patientId       String          @unique
  email           String
  passwordHash    String
  status          String          @default("active")
  emailVerifiedAt DateTime?
  mfaEnabled      Boolean         @default(false)
  mustReset       Boolean         @default(false)
  failedAttempts  Int             @default(0)
  lockedUntil     DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  patient         Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  sessions        PortalSession[]

  @@unique([organizationId, email])
  @@index([email, status])
  @@map("portal_accounts")
}

model PortalSession {
  id              String        @id
  portalAccountId String
  expiresAt       DateTime
  lastSeenAt      DateTime      @default(now())
  revokedAt       DateTime?
  ipAddress       String?
  userAgent       String?
  deviceLabel     String?
  authLevel       String        @default("password")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  portalAccount   PortalAccount @relation(fields: [portalAccountId], references: [id], onDelete: Cascade)

  @@index([portalAccountId, revokedAt, expiresAt])
  @@map("portal_sessions")
}

model AuthSession {
  id          String    @id
  userId      String
  expiresAt   DateTime
  lastSeenAt  DateTime  @default(now())
  revokedAt   DateTime?
  ipAddress   String?
  userAgent   String?
  deviceLabel String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@map("auth_sessions")
}

model PasskeyCredential {
  id           String    @id @default(cuid())
  userId       String
  credentialId String    @unique
  publicKey    Bytes
  counter      BigInt    @default(0)
  transports   String[]
  deviceType   String?
  backedUp     Boolean   @default(false)
  nickname     String?
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("passkey_credentials")
}

model Role {
  id             String   @id @default(cuid())
  organizationId String?
  key            String
  name           String
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, key])
  @@map("roles")
}

model Permission {
  id        String   @id @default(cuid())
  roleId    String
  resource  String
  action    String
  allowed   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roleId])
  @@map("permissions")
}

model Provider {
  id                             String                      @id @default(cuid())
  organizationId                 String
  userId                         String?                     @unique
  name                           String
  displayName                    String
  legalName                      String
  engagementType                 String                      @default("staff")
  contactEmail                   String?
  contactPhone                   String?
  credential                     String
  providerType                   String
  specialty                      String?
  subspecialty                   String?
  taxonomy                       String?
  npi                            String?
  deaNumber                      String?
  deaExpiresAt                   DateTime?
  malpracticeCarrier             String?
  malpracticePolicyNumber        String?
  malpracticeExpiration          DateTime?
  malpracticeCoverageAmountCents Int?
  malpracticeEvidenceReference   String?
  malpracticeVerificationStatus  String                      @default("pending")
  malpracticeVerifiedAt          DateTime?
  malpracticeVerifiedBy          String?
  malpracticeReviewNotes         String?
  malpracticeAuthorityVersion    Int                         @default(1)
  certifications                 String[]                    @default([])
  servicesOffered                String[]                    @default([])
  experienceLevel                String                      @default("Entry")
  bio                            String?
  profilePhoto                   String?
  serviceLocations               String[]                    @default([])
  mobileServiceAllowed           Boolean                     @default(false)
  chairRentalAllowed             Boolean                     @default(false)
  atHomeAllowed                  Boolean                     @default(false)
  travelRadiusMiles              Int                         @default(0)
  onCallNow                      Boolean                     @default(false)
  verificationStatus             String                      @default("draft")
  applicationSubmittedAt         DateTime?
  approvedBy                     String?
  approvedAt                     DateTime?
  renewalDueAt                   DateTime?
  telemedicineEligible           Boolean                     @default(false)
  prescribingEligible            Boolean                     @default(false)
  acceptedInsurance              String[]                    @default([])
  services                       String[]                    @default([])
  status                         String                      @default("active")
  createdAt                      DateTime                    @default(now())
  updatedAt                      DateTime                    @updatedAt
  organization                   Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                           User?                       @relation(fields: [userId], references: [id], onDelete: SetNull)
  facilityPrivileges             ProviderFacilityPrivilege[]
  credentials                    ProviderCredential[]
  availability                   ProviderAvailability[]
  gridServiceListings            GridServiceListing[]
  gridRequests                   GridRequest[]
  gridPayouts                    GridPayout[]

  @@index([organizationId, status, verificationStatus])
  @@index([providerType, verificationStatus])
  @@map("providers")
}

model ProviderCredential {
  id                      String    @id @default(cuid())
  organizationId          String
  providerId              String
  type                    String
  number                  String
  state                   String?
  expiresAt               DateTime?
  status                  String    @default("active")
  verificationStatus      String    @default("pending")
  verificationSource      String?
  primarySourceVerifiedAt DateTime?
  evidenceDocumentId      String?
  evidenceReference       String?
  exceptionReason         String?
  verifiedBy              String?
  reviewNotes             String?
  authorityVersion        Int       @default(1)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  provider                Provider  @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@map("provider_credentials")
}

model ProviderFacilityPrivilege {
  id                 String       @id @default(cuid())
  organizationId     String
  providerId         String
  facilityId         String
  status             String       @default("pending")
  grantedAt          DateTime?
  expiresAt          DateTime?
  verificationSource String?
  notes              String?
  authorityVersion   Int          @default(1)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider           Provider     @relation(fields: [providerId], references: [id], onDelete: Cascade)
  facility           Facility     @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@unique([organizationId, providerId, facilityId])
  @@index([organizationId, status, expiresAt])
  @@map("provider_facility_privileges")
}

model Patient {
  id                  String              @id @default(cuid())
  organizationId      String
  locationId          String?
  mrn                 String
  masterPatientId     String?
  firstName           String
  lastName            String
  preferredName       String?
  formerNames         String[]            @default([])
  aliases             String[]            @default([])
  dateOfBirth         DateTime
  sexAtBirth          String?
  genderIdentity      String?
  pronouns            String?
  phone               String?
  email               String?
  preferredLanguage   String              @default("English")
  portalStatus        String              @default("inactive")
  identityStatus      String              @default("unverified")
  identityVerifiedAt  DateTime?
  identityVerifiedBy  String?
  communicationPrefs  Json?
  riskLevel           RiskLevel           @default(NORMAL)
  requiresHumanReview Boolean             @default(false)
  reviewedBy          String?
  reviewedAt          DateTime?
  status              String              @default("active")
  deceasedAt          DateTime?
  archivedAt          DateTime?
  createdBy           String?
  updatedBy           String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  organization        Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  appointments        Appointment[]
  encounters          Encounter[]
  identifiers         PatientIdentifier[]
  matchSources        PatientMatch[]      @relation("PatientMatchSource")
  matchCandidates     PatientMatch[]      @relation("PatientMatchCandidate")
  accessGrants        AccessGrant[]
  recordRequests      RecordRequest[]
  careTeamRooms       CareTeamRoom[]
  episodeRooms        EpisodeRoom[]
  healthPassport      HealthPassport?
  consentWallet       ConsentWallet?
  intakePassport      IntakePassport?
  careHandoffs        CareHandoff[]
  gridRequests        GridRequest[]
  remoteObservations  RemoteObservation[]
  voiceSessions       VoiceSession[]
  leads               Lead[]
  portalAccount       PortalAccount?

  @@unique([organizationId, mrn])
  @@index([masterPatientId])
  @@index([organizationId, lastName, firstName])
  @@map("patients")
}

model PatientContact {
  id             String   @id @default(cuid())
  organizationId String
  patientId      String
  type           String
  value          String
  preferred      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([patientId])
  @@map("patient_contacts")
}

model PatientInsurance {
  id              String    @id @default(cuid())
  organizationId  String
  patientId       String
  priority        Int       @default(1)
  payer           String
  planName        String?
  memberId        String
  groupNumber     String?
  effectiveDate   DateTime?
  terminationDate DateTime?
  status          String    @default("active")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([patientId])
  @@map("patient_insurance")
}

model PatientPharmacy {
  id                           String    @id @default(cuid())
  organizationId               String
  patientId                    String
  name                         String
  ncpdpId                      String?
  npi                          String?
  phone                        String?
  fax                          String?
  address                      Json?
  hours                        Json?
  preferred                    Boolean   @default(false)
  electronicPrescribingEnabled Boolean   @default(false)
  controlledSubstancesEnabled  Boolean   @default(false)
  status                       String    @default("active")
  source                       String    @default("manual")
  verifiedBy                   String?
  verifiedAt                   DateTime?
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  @@index([organizationId, status, name])
  @@index([patientId, preferred])
  @@map("patient_pharmacies")
}

model PatientPreference {
  id             String   @id @default(cuid())
  organizationId String
  patientId      String
  key            String
  value          Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([patientId, key])
  @@map("patient_preferences")
}

model EmergencyContact {
  id             String   @id @default(cuid())
  organizationId String
  patientId      String
  name           String
  relationship   String
  phone          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([patientId])
  @@map("emergency_contacts")
}

model AppointmentType {
  id              String   @id @default(cuid())
  organizationId  String
  name            String
  durationMinutes Int
  color           String?
  telemedicine    Boolean  @default(false)
  status          String   @default("active")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
  @@map("appointment_types")
}

model Appointment {
  id                String            @id @default(cuid())
  organizationId    String
  locationId        String?
  patientId         String
  providerId        String?
  appointmentTypeId String?
  startsAt          DateTime
  endsAt            DateTime
  status            AppointmentStatus @default(REQUESTED)
  telemedicine      Boolean           @default(false)
  formsComplete     Boolean           @default(false)
  insuranceVerified Boolean           @default(false)
  paymentDueCents   Int               @default(0)
  notes             String?
  createdBy         String?
  updatedBy         String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  patient           Patient           @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([organizationId, startsAt])
  @@index([patientId, startsAt])
  @@map("appointments")
}

model ProviderAvailability {
  id             String       @id @default(cuid())
  organizationId String
  providerId     String
  locationId     String?
  weekday        Int
  startsAt       String
  endsAt         String
  locationType   String       @default("clinic_location")
  mobileRadius   Int          @default(0)
  onCall         Boolean      @default(false)
  status         String       @default("active")
  recurrence     Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider       Provider     @relation(fields: [providerId], references: [id], onDelete: Cascade)
  location       Location?    @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([organizationId, providerId, status])
  @@index([locationId, weekday, status])
  @@map("provider_availability")
}

model GridServiceListing {
  id                    String        @id @default(cuid())
  organizationId        String
  providerId            String
  serviceName           String
  category              String
  description           String
  priceLowCents         Int
  priceHighCents        Int
  requiresMedicalReview Boolean       @default(false)
  requiresConsent       Boolean       @default(true)
  requiresDeposit       Boolean       @default(false)
  mobileAllowed         Boolean       @default(false)
  clinicLocationAllowed Boolean       @default(true)
  chairRentalAllowed    Boolean       @default(false)
  status                String        @default("draft")
  createdBy             String?
  approvedBy            String?
  approvedAt            DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  organization          Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider              Provider      @relation(fields: [providerId], references: [id], onDelete: Cascade)
  requests              GridRequest[]

  @@index([organizationId, status, category])
  @@index([providerId, status])
  @@map("grid_service_listings")
}

model GridRequest {
  id                        String             @id @default(cuid())
  organizationId            String
  destinationOrganizationId String
  requesterId               String
  patientId                 String?
  syntheticClientLabel      String
  syntheticClientReference  String
  serviceListingId          String
  providerId                String
  locationId                String?
  requestedStartAt          DateTime
  requestedEndAt            DateTime?
  counterStartAt            DateTime?
  locationType              String
  safetyFlags               String[]           @default([])
  requiredDocuments         String[]           @default([])
  requiredConsent           Boolean            @default(true)
  consentStatus             String             @default("pending")
  depositStatus             String             @default("not_started")
  paymentStatus             String             @default("not_started")
  status                    String             @default("draft")
  notes                     String?
  reviewedBy                String?
  reviewedAt                DateTime?
  confirmedAt               DateTime?
  completedAt               DateTime?
  cancelledAt               DateTime?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt
  organization              Organization       @relation("GridRequestOrigin", fields: [organizationId], references: [id], onDelete: Cascade)
  destinationOrganization   Organization       @relation("GridRequestDestination", fields: [destinationOrganizationId], references: [id], onDelete: Restrict)
  patient                   Patient?           @relation(fields: [patientId], references: [id], onDelete: SetNull)
  serviceListing            GridServiceListing @relation(fields: [serviceListingId], references: [id], onDelete: Restrict)
  provider                  Provider           @relation(fields: [providerId], references: [id], onDelete: Restrict)
  location                  Location?          @relation(fields: [locationId], references: [id], onDelete: SetNull)
  events                    GridRequestEvent[]
  payout                    GridPayout?

  @@index([organizationId, status, createdAt])
  @@index([destinationOrganizationId, status, createdAt])
  @@index([providerId, requestedStartAt, status])
  @@index([patientId, createdAt])
  @@map("grid_requests")
}

model GridRequestEvent {
  id             String       @id @default(cuid())
  organizationId String
  gridRequestId  String
  actorId        String?
  actorType      String
  action         String
  fromStatus     String?
  toStatus       String?
  note           String?
  metadata       Json?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  request        GridRequest  @relation(fields: [gridRequestId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([gridRequestId, createdAt])
  @@map("grid_request_events")
}

model GridPayout {
  id                String       @id @default(cuid())
  organizationId    String
  providerId        String
  gridRequestId     String       @unique
  grossAmountCents  Int
  platformFeeCents  Int          @default(0)
  netAmountCents    Int
  status            String       @default("estimated")
  approvedAt        DateTime?
  paidAt            DateTime?
  externalReference String?
  notes             String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider          Provider     @relation(fields: [providerId], references: [id], onDelete: Restrict)
  gridRequest       GridRequest  @relation(fields: [gridRequestId], references: [id], onDelete: Cascade)

  @@index([organizationId, status, createdAt])
  @@index([providerId, status, createdAt])
  @@map("grid_payouts")
}

model Room {
  id             String   @id @default(cuid())
  organizationId String
  locationId     String
  name           String
  type           String?
  status         String   @default("active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([locationId])
  @@map("rooms")
}

model CheckIn {
  id             String    @id @default(cuid())
  organizationId String
  appointmentId  String
  arrivedAt      DateTime?
  roomedAt       DateTime?
  checkoutAt     DateTime?
  status         String    @default("pending")
  readiness      Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([appointmentId])
  @@map("check_ins")
}

model Waitlist {
  id                String   @id @default(cuid())
  organizationId    String
  patientId         String
  appointmentTypeId String?
  preferences       Json?
  status            String   @default("active")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([organizationId, status])
  @@map("waitlist")
}

model Encounter {
  id                  String          @id @default(cuid())
  organizationId      String
